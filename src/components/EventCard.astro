---
// A single event card. `variant` controls upcoming (accent date, "Learn more"
// link) vs past (muted date, no link) styling. Shared by the landing
// UpcomingEvents section, the chapter pages and the /events page so all event
// cards stay identical.
//
// The card's frame is the shared `.card` (tokens.css) rather than the inline
// border/radius/padding this file used to carry, so it matches the sponsor,
// volunteer and chapter cards instead of being a fourth card shape.
//
// ONE SHAPE FOR EVERY CARD (owner, 2026-10-14). Each card opens on a square
// image (`EventCardMedia`: the cover, or the H mark when there is none), then
// the date, a title held to two lines, and the place. The place line keeps its
// height when empty, so a row of cards lines up whatever each one carries.
import EventCardMedia from './EventCardMedia.astro';
import { formatEventDate, type EventLike } from '../lib/events';
import { externalLinkAttrs } from '../lib/externalLink';

interface Props {
  event: EventLike;
  variant?: 'upcoming' | 'past';
}
const { event, variant = 'upcoming' } = Astro.props;
const isPast = variant === 'past';
---

<article class:list={['card', 'ev', isPast && 'ev--past']}>
  <EventCardMedia coverImage={event.coverImage} />
  <div class="ev-body">
    <time class="ev-date">{formatEventDate(event.date)}</time>
    <h3 class="ev-title">{event.title}</h3>
    <p class="ev-where">{event.location ?? ''}</p>
    {event.description ? <p class="ev-blurb">{event.description}</p> : null}
    {
      !isPast && event.link ? (
        <a
          class="link-more ev-go"
          href={event.link}
          {...externalLinkAttrs(event.link, Astro.url.origin)}
        >
          Learn more →
        </a>
      ) : null
    }
  </div>
</article>

<style>
  .ev {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    text-align: left;
  }
  .ev-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--s-3) var(--s-4) var(--s-4);
  }
  .ev-date {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  .ev--past .ev-date {
    color: var(--ink-3);
  }
  /* Two lines, always: a long title is clipped rather than pushing its card
     taller than its neighbours, and a short one still reserves the space. */
  .ev-title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    min-height: calc(2 * 1.25em);
    margin: var(--s-2) 0;
    font-family: var(--font-title);
    font-size: var(--t-lg);
    line-height: 1.25;
    color: var(--ink);
  }
  .ev-where {
    min-height: 1.5em;
    margin: 0;
    font-size: var(--t-sm);
    line-height: 1.5;
    color: var(--ink-3);
  }
  .ev-blurb {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: var(--s-2) 0 0;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-2);
  }
  /* Pinned to the bottom so a row of cards with different blurb lengths still
     lines its links up. */
  .ev-go {
    margin-top: auto;
    padding-top: var(--s-3);
  }
</style>
