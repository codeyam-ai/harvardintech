---
// The banner at the top of a chapter or community page.
//
// It is now a thin adapter over `ui/PageBanner.astro` — the same banner the
// sponsor, volunteer, site-page and blog headers render — so a chapter no
// longer has a header of its own design. What it keeps is the chapter-shaped
// API (`name` / `region` / `blurb` / `tagline`) that the pages already pass.
//
// Two things changed in the move, both owner decisions (2026-09-14):
//
//   LEFT-ALIGNED, and no longer a full screen. The old header filled
//   `100svh - header`, so on a phone a reader met a photo and a title and had
//   to scroll before learning the page had content. It also centred the title
//   between two 80px rules, which is what made "Seattle / Pacific Northwest"
//   wrap mid-phrase across two centred lines.
//
//   THE LABEL STAYS ABOVE THE NAME. `label` is unchanged and still arrives from
//   the page; `src/lib/pageBanner.ts` derives it. The flanking-rule treatment
//   and the uppercase title are gone with the rest of the old header.
//
// `region` and `blurb` are still accepted because the pages pass them, and the
// paper tone uses `blurb` as its lede when no `tagline` is set — that is what
// `ChapterHeader` did for an image-less chapter. That component now has no
// importers and is due for deletion with the rest of the unused set.
import PageBanner from './ui/PageBanner.astro';

interface Props {
  /** The city (chapter) or community name. Never prefixed with the org name. */
  name: string;
  region?: string;
  blurb?: string;
  heroImage?: string;
  tagline?: string;
  /** "Chapter", "Online group", "Community" — see `lib/pageBanner.ts`. */
  label?: string;
}
const { name, region, blurb, heroImage, tagline, label = 'Chapter' } = Astro.props as Props;

// A chapter with a photo gets the photo tone; one without falls back to paper
// rather than to a second component. The region is appended to the lede rather
// than to the title, so a long "Seattle / Pacific Northwest" never competes
// with the name for the heading's line.
const lede = tagline ?? blurb;
---

<PageBanner
  label={label}
  title={name}
  lede={lede}
  image={heroImage}
  tone={heroImage ? 'photo' : 'paper'}
>
  {region ? <p class="chapter-region">{region}</p> : null}
</PageBanner>

<style>
  .chapter-region {
    margin: var(--s-2) 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    /* Published by PageBanner, so this line stays legible on the photo tone as
       well as on paper. See the note on `--banner-muted` there. */
    color: var(--banner-muted, var(--ink-3));
  }
</style>
