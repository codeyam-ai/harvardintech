---
// Per-chapter events section — what is coming up, and (as the `past` variant)
// the last few that happened. Takes an already-filtered, already-sorted list
// for one chapter and renders the shared EventCards, so chapter cards stay
// identical to the landing section and the /events page.
//
// The EMPTY branch differs by variant, and the difference is the point:
//
//   `upcoming` with nothing scheduled shows an empty state with a way to hear
//   about the next one. This block used to render nothing at all, which on a
//   quiet chapter left the page with no mention of events and no way to follow
//   them — the reader could not tell the difference between "no events" and
//   "this page forgot to load".
//
//   `past` with nothing stays hidden. A chapter that has not run an event yet
//   has nothing to say here, and "no past events" is noise on a new page.
import EventCardGrid from './EventCardGrid.astro';
import SectionHead from './ui/SectionHead.astro';
import EmptyState from './ui/EmptyState.astro';
import type { EventLike } from '../lib/events';
import { siteLinks } from '../lib/site';

interface Props {
  events?: EventLike[];
  /** The city (chapter) or community name the default heading is built from. */
  name: string;
  /** Overrides the default "Upcoming Events in <name>" phrasing. A community is
   *  not a place, so /communities passes "Upcoming <name> Events" instead. */
  heading?: string;
  /**
   * `upcoming` (the default) or `past`.
   *
   * It carries its own heading and its own section id: two sections sharing
   * `id="chapter-events"` would be invalid HTML and would break any link to
   * either.
   */
  variant?: 'upcoming' | 'past';
}
const { events = [], name, heading, variant = 'upcoming' } = Astro.props;
const isPast = variant === 'past';
const title = heading ?? (isPast ? `Recent events in ${name}` : `Upcoming Events in ${name}`);
const sectionId = isPast ? 'chapter-past-events' : 'chapter-events';

const hasEvents = events.length > 0;
const show = hasEvents || !isPast;
---

{
  show ? (
    <section class="sec" id={sectionId}>
      <div class="wrap">
        <SectionHead title={title} align="center" />
        {hasEvents ? (
          <EventCardGrid events={events} variant={variant} />
        ) : (
          <EmptyState
            title={`No events scheduled in ${name} yet.`}
            body="We'll announce the next one to the mailing list first."
            actionHref={siteLinks().mailingList}
            actionLabel="Get event announcements"
          />
        )}
      </div>
    </section>
  ) : null
}

