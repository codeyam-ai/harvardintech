---
import Component from "@codeyam/cms/components/admin/ImageField.tsx";
import "../../styles/tokens.css";

// Isolation page for a chapter's cover-image field right after the editor
// uploaded a new photo from its picker — the exact spot the upload bug lived.
//
// Two fixes meet here. The single upload now fills the field on its own (the
// picker used to wait for a second click nobody asked for), and the thumbnail
// shows the staged bytes rather than the `/images/...` url, which 404s until
// publish. Before, this field sat empty or showed a broken image, and editors
// uploaded again — the byte-identical `-2` copies in `813e3b9` and `75d884d`.
//
// The staged bytes live in the CMS staging store in localStorage, the only seam
// `imageSrc` reads, so the inline script seeds one staged image before the
// island mounts and restores the store when the page is left. `client:only`
// for the same reason as MediaCard-StagedUpload: a server render cannot see
// browser storage, and React keeps a mismatched `src` on hydration.
const FIELD = { name: 'image', label: 'Cover image', type: 'image' as const, optional: true };
const VALUE = '/images/nyc-skyline.svg';
const STAGED_BYTES =
  '';
const STAGED = [
  {
    collection: 'media',
    slug: 'nyc-skyline.svg',
    path: 'public/images/nyc-skyline.svg',
    title: 'nyc-skyline.svg',
    original: '',
    updated: STAGED_BYTES,
    kind: 'edit',
    encoding: 'base64',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: ImageField - Staged Upload</title>
    <script is:inline define:vars={{ staged: STAGED }}>
      const KEY = 'codeyam-cms:pending-changes';
      try {
        const prior = localStorage.getItem(KEY);
        localStorage.setItem(KEY, JSON.stringify(staged));
        addEventListener('pagehide', () => {
          if (prior === null) localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, prior);
        });
      } catch {}
    </script>
  </head>
  <body style="margin: 0; background: var(--color-bg, #fff);">
    <div id="codeyam-capture" style="padding: 2rem; width: 100%; max-width: 640px;">
      <Component client:only="react" field={FIELD} value={VALUE} onPick={() => {}} onClear={() => {}} />
    </div>
  </body>
</html>
