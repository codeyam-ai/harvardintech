                "text1": {
                  "type": "RichText",
                  "id": "f_be9310a4-e61b-4f43-9c31-1ed46c44eb6a",
                  "defaultValue": false,
                  "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" font-size-tag-header-four s-text-font-size-over-default s-rich-text-wrapper\" style=\"text-align: left; font-size: 20px;\"><span style=\"color: #000000;\">An Elevated Evening of Ideas, Connection &amp; Conversation</span></p></div>",
                  "backupValue": null,
                  "version": 1,
                  "lineAlignment": {
                    "firstLineTextAlign": "left",
                    "lastLineTextAlign": "left"
                  },
                  "defaultDataProcessed": true
                },
                "text2": {
                  "type": "RichText",
                  "id": "f_ba0b9aaf-e697-4126-b7c4-49d2807df231",
                  "defaultValue": true,
                  "value": "",
                  "backupValue": null,
                  "version": null
                },
                "text3": {
                  "type": "RichText",
                  "id": "f_efd78f05-5819-4831-8de9-15ff93d9136c",
                  "defaultValue": false,
                  "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><br><span style=\"color: #000000;\">Join </span><span style=\"color: #0a66c2;\"><a style=\"color: #0a66c2;\" href=\"https://www.linkedin.com/company/harvardintech/\" data-type=\"\" target=\"_blank\"><strong>Harvard Alumni in Tech</strong></a></span><span style=\"color: #000000;\"> as we welcome the fall season with new and returning alumni at an exclusive rooftop gathering in Hudson Yards.</span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><br><span style=\"color: #000000;\">Designed to spark meaningful discussion and new connections, the evening will bring together members of the Harvard community who are passionate about technology and innovation. </span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><span style=\"display: inline-block\"></span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><span style=\"color: #000000;\">Take part in curated tabletop conversations exploring emerging technologies, industry shifts, and what’s next in tech, all while enjoying sunset views over the Hudson.</span></p><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: left; font-size: 13px;\"><br><span style=\"color: #000000;\"><strong>Date: September 28, 2026Time: 6 PM - 9 PM</strong></span></p><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: left; font-size: 13px;\"><span style=\"color: #000000;\"><strong>Location: Private rooftop in Hudson Yards</strong></span></p><p class=\" s-rich-text-wrapper font-size-tag-custom s-text-font-size-over-default\" style=\"text-align: left; font-size: 13px;\"><span style=\"color: #000000;\"><strong>Light bites and refreshments are included</strong></span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><br><span style=\"color: #000000;\">This event is open to Harvard alumni only; +1s are welcome but must be accompanied by a ticketed alum. Space is limited, and advance registration is required.</span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><br><span style=\"color: #000000;\">We look forward to seeing you!</span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><span style=\"display: inline-block\"></span></p><p class=\" s-rich-text-wrapper\" style=\"text-align: left;\"><a href=\"https://hi.switchy.io/_t_t\" data-type=\"undefined\" target=\"_blank\">Purchase Tickets</a><br></p></div>",
                  "backupValue": null,
                  "version": 1,
                  "lineAlignment": {
                    "firstLineTextAlign": "left",
                    "lastLineTextAlign": "left"
                  },
                  "defaultDataProcessed": true
                },
