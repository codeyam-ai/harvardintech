---
// "Show all N photos" — the control under a capped gallery.
//
// Rendered only when photos are actually hidden; EventGallery decides that, so
// this component never renders a button that would reveal nothing. The photos
// it reveals already shipped in the HTML as hidden tiles, so the click is
// instant and needs no refetch.
import type { GalleryTier } from '../../lib/gallery';

interface Props {
  /** The full photo count, including the hidden ones — the number in the label. */
  total: number;
  /** The grid widths at which photos are hidden. The button shows only at
   *  those, so a width that already shows everything never offers one. */
  tiers: GalleryTier[];
}

const { total, tiers } = Astro.props;
---

<div
  class="gallery-more"
  data-show-desktop={tiers.includes('desktop') ? '' : undefined}
  data-show-tablet={tiers.includes('tablet') ? '' : undefined}
  data-show-phone={tiers.includes('phone') ? '' : undefined}
>
  <button type="button" class="gallery-expand" data-gallery-expand>
    Show all {total} photos
  </button>
</div>

<style>
  .gallery-more {
    text-align: center;
    margin-top: 16px;
  }
  /* Same three widths as EventGallery's grid: >900px, 601–900px, ≤600px. */
  @media (min-width: 901px) {
    .gallery-more:not([data-show-desktop]) {
      display: none;
    }
  }
  @media (min-width: 601px) and (max-width: 900px) {
    .gallery-more:not([data-show-tablet]) {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .gallery-more:not([data-show-phone]) {
      display: none;
    }
  }
  .gallery-expand {
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1.2rem;
    border: 1px solid var(--color-border, rgba(30, 26, 27, 0.14));
    border-radius: 4px;
    background: var(--white);
    cursor: pointer;
  }
  .gallery-expand {
    min-height: 44px;
  }
  .gallery-expand:hover {
    border-color: var(--color-accent, #a41034);
    color: var(--color-accent, #a41034);
  }
</style>
