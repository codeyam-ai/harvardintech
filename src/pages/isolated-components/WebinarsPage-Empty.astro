---
import Component from "../../../src/components/WebinarsPage.astro";
import "../../../src/styles/tokens.css";

// Isolation page for WebinarsPage with NOTHING published — codeyam screenshots
// the #codeyam-capture wrapper by navigating to
// /isolated-components/WebinarsPage-Empty.
//
// A separate prerendered page rather than a `?s=` switch: this is a static
// build, so query params are empty at build time and one page would capture the
// default frame for both states.
//
// This state is one CMS toggle away at any time, and five of the eleven
// recordings are already in it — their video host lost the uploads. The page
// has to keep explaining what the series was even when it can show none of it,
// rather than collapsing to a bare heading.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: WebinarsPage-Empty</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: var(--space-lg); width: 100%; max-width: 1100px;">
      <Component posts={[]} />
    </div>
  </body>
</html>
