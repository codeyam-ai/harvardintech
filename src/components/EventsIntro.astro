---
// The /events title and standfirst, with no band of its own.
//
// The ROUTE does not render this — it renders `EventsIntroBand`, which puts the
// same words in the shared page banner above the Luma calendar. This is what
// `EventsPage` falls back to when it is captured on its own in an
// isolated-component scenario, away from the route that would have supplied the
// banner. Both read their standfirst from `lib/eventsIntro.ts`, so the page and
// the isolated capture cannot describe a different set of chapters.
import { getCollection } from 'astro:content';
import { chapterNavItems } from '../lib/nav';
import { publishedEntries } from '../lib/drafts';
import { INCLUDE_DRAFTS } from '../lib/draftVisibility';
import { eventsLede } from '../lib/eventsIntro';

const chapters = publishedEntries(await getCollection('chapters'), INCLUDE_DRAFTS).map((c) => ({
  slug: c.id,
  ...c.data,
}));
const lede = eventsLede(chapterNavItems(chapters).map((c) => c.label));
---

<span class="kick">Programs</span>
<h1 class="events-title">Events</h1>
<p class="events-lede">{lede}</p>

<style>
  .events-title {
    margin: var(--s-2) 0 0;
    font-family: var(--font-title);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .events-lede {
    margin: var(--s-3) 0 var(--s-6);
    max-width: var(--text-width);
    font-size: var(--t-lg);
    line-height: 1.6;
    color: var(--ink-2);
  }
</style>
