---
// The links at the foot of a project card: through to the full description, and
// out to the project's own sign-up form.
//
// Two levels, per the site's button system (owner, 2026-10-14): "Get involved"
// is the card's main action, so it is a pill with no arrow; "Read the full
// description →" is the quieter "more about this item" link, in the shared
// `.link-more` style. Stacked, with the pill last so it closes the card.
// Renders an empty flex container when a card has neither link, and `gap`
// means that costs no space.
import { externalLinkAttrs } from '../../lib/externalLink';
import { withBase } from '../../lib/url';

interface Props {
  /** The card's detail-page link, already base-prefixed. Absent → not shown. */
  href?: string;
  applyUrl?: string;
}
const { href, applyUrl } = Astro.props as Props;
---

<div class="foot">
  {
    href ? (
      <a class="link-more" href={href}>
        Read the full description →
      </a>
    ) : null
  }
  {
    applyUrl ? (
      <a
        class="btn btn-solid"
        href={withBase(applyUrl)}
        {...externalLinkAttrs(applyUrl, Astro.url.origin)}
      >
        Get involved
      </a>
    ) : null
  }
</div>

<style>
  .foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-3);
    margin-top: 4px;
  }
</style>
