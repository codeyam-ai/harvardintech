---
// "Giving campaign" (Atlas crimson CTA band): the fundraising ask with Donate /
// Sponsor actions. No fabricated progress meter — real campaign totals can be
// added later via the CMS if desired; until then this is a clean call to give.
//
// It follows the same switch as /donate. Until `donateUrl` is set the campaign
// has not opened, so there is no Donate button: both of this band's actions used
// to open a `mailto:`, which asked for money the organization could not yet
// take and put a personal inbox in front of a sponsor. Now the band states when
// the campaign opens and links to the page that explains it, while Sponsorship —
// which IS open for business — goes to /sponsor.
import GivingSoonNote from '../donate/GivingSoonNote.astro';
import { isGivingOpen, resolveGiveHref } from '../../lib/giving';
import { withBase } from '../../lib/url';

interface Props {
  email?: string;
  headline?: string;
  blurb?: string;
  donateUrl?: string;
}
const {
  email = 'ben@harvardintech.com',
  headline = 'Back the mission.',
  blurb,
  donateUrl,
} = Astro.props as Props;

const open = isGivingOpen(donateUrl);
const donateHref = open ? resolveGiveHref({ donateUrl, email }) : undefined;
const sponsorHref = withBase('/sponsor');
// Pre-launch the band must not describe a gift as if one can be made today.
const defaultBlurb = open
  ? 'Your gift funds in-person events, new chapters, and our global community, keeping Harvard Alumni in Tech free and open to every alum in technology.'
  : 'Our first fundraising campaign will fund in-person events, new chapters, and our global community, keeping Harvard Alumni in Tech free and open to every alum in technology.';
const bodyText = blurb ?? defaultBlurb;
---

<section class="giving" id="giving">
  <div class="wrap giving-in">
    <div class="giving-copy">
      <span class="kick" style="color:#fff">Giving campaign</span>
      <h3>{headline}</h3>
      <p>{bodyText}</p>
    </div>
    <div class="giving-actions">
      {
        open ? (
          <a class="btn btn-solid" href={donateHref} rel="noopener">
            Donate
          </a>
        ) : (
          <GivingSoonNote
            onDark
            linkHref="/donate"
            linkLabel="Read about the Momentum Fund"
          />
        )
      }
      <a class="btn btn-out on-dark" href={sponsorHref}>Sponsorship</a>
    </div>
  </div>
</section>

<style>
  .giving {
    background: var(--crimson);
    color: #fff;
    border-bottom: 1px solid var(--line);
  }
  .giving-in {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 40px;
    align-items: center;
    /* Matches the Get involved band directly above — the two colour fields are
       read as a pair, so they breathe the same. */
    padding: 112px 48px;
  }
  .giving-copy h3 {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 8px 0 10px;
  }
  .giving-copy p {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    max-width: 52ch;
    margin: 0;
  }
  /* Stacked and equal width, matching the Get involved band directly above it —
     the two crimson/ink CTA bands are read as a pair, so their action blocks
     have to share a shape. */
  .giving-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
    width: 100%;
    max-width: 300px;
    margin-left: auto;
  }
  .giving-actions .btn {
    font-size: 16px;
    padding: 18px 28px;
    text-align: center;
  }
  .giving .btn-solid {
    background: #fff;
    color: var(--crimson);
  }
  .giving .btn-solid:hover {
    background: rgba(255, 255, 255, 0.9);
  }
  @media (max-width: 820px) {
    .giving-in {
      grid-template-columns: 1fr;
      padding: 48px 24px;
    }
    .giving-actions {
      margin-left: 0;
    }
  }
</style>
