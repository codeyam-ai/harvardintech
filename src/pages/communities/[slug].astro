---
// /communities/<slug> — one page per interest-based community (Founders, AI),
// the non-geographic counterpart to /chapters/<slug>. Same collection shape and
// same draft rule, but its OWN page component: a community leads with what it
// does, a chapter leads with where it is. See `CommunityPage.astro` for why
// sharing the chapter shell stopped working.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CommunityPage from '../../components/CommunityPage.astro';
import { splitEvents, eventsTaggedTo, recentPastEvents } from '../../lib/events';
import LockedPreviewBody from '../../components/LockedPreviewBody.astro';
import { isLocked, isPreview, publishedEntries, routableEntries } from '../../lib/drafts';
import { INCLUDE_DRAFTS } from '../../lib/draftVisibility';

// Drafts get no page on the public site — a community dropped from the nav but
// still live at /communities/<slug> would be public anyway. In dev and on the
// review track the page is generated so it can be read before it is announced.
//
// `routableEntries` also builds preview pages, which the nav never lists. See
// `src/lib/drafts.ts` for why building and listing are separate questions.
export async function getStaticPaths() {
  const communities = routableEntries(
    await getCollection('communities'),
    INCLUDE_DRAFTS,
  );

  return communities.map((community) => ({
    params: { slug: community.id },
    props: { community },
  }));
}

type Props = { community: CollectionEntry<'communities'> };
const { community } = Astro.props as Props;
const { Content } = await render(community);
// `photos` is DELIBERATELY absent from this destructure and from the
// CommunityPage call below. A chapter curates its own gallery in /admin and
// passes it through; a community is scoped out of that feature on purpose, so
// it keeps the shared 40-photo event wall every page showed before per-chapter
// galleries existed. The boundary is enforced twice over: the `communities`
// schema declares no `photos` field (src/content/config.ts), so there is nothing
// on `community.data` to forward even if this call site grew the prop.
// `showGallery: false` still hides the section outright, as it does for a chapter.
const { name, blurb, heroImage, tagline, showGallery, leads, links, callouts, whatsappFormUrl } =
  community.data;

// Events reach a community by the `chapter` tag (ids are unique across both
// collections) or by naming it in their own `communities` list — which is what
// lets a London Founders co-working day appear here AND on the London chapter
// page. The chapters route warns about tags matching neither list, so a typo is
// still caught.
const events = publishedEntries(await getCollection('events'), INCLUDE_DRAFTS);
const { upcoming, past } = splitEvents(eventsTaggedTo(events, community.id));
const recent = recentPastEvents(past);
---

<BaseLayout
  title={name}
  description={blurb ?? `The Harvard Alumni in Tech ${name} community.`}
  noindex={isPreview(community)}
>
  {
    isLocked(community) ? (
      <LockedPreviewBody
        ciphertext={community.body ?? ''}
        lock={community.data.previewLock ?? ''}
      />
    ) : (
      <CommunityPage
        name={name}
        blurb={blurb}
        heroImage={heroImage}
        tagline={tagline}
        showGallery={showGallery}
        callouts={callouts}
        whatsappFormUrl={whatsappFormUrl}
        events={upcoming}
        pastEvents={recent}
        leads={leads}
        links={links}
      >
        <Content />
      </CommunityPage>
    )
  }
</BaseLayout>
