---
// /chapters/<slug> — one page per regional chapter. Static output enumerates a
// route per `chapters` collection entry via getStaticPaths; ChapterPage renders
// the frontmatter (city, leads, links) and the markdown body in its slot.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChapterPage from '../../components/ChapterPage.astro';
import {
  splitEvents,
  unmatchedChapterTags,
  eventsTaggedTo,
  recentPastEvents,
} from '../../lib/events';
import { emailFor } from '../../lib/contact';
import { settings } from '../../lib/site';
import LockedPreviewBody from '../../components/LockedPreviewBody.astro';
import { isLocked, isPreview, publishedEntries, routableEntries } from '../../lib/drafts';
import { INCLUDE_DRAFTS } from '../../lib/draftVisibility';

// Drafts get no page of their own on the public site — a chapter dropped from
// the nav but still live at /chapters/<slug> would be public anyway. In dev and
// on the review track the page is generated so an unannounced chapter can be read.
export async function getStaticPaths() {
  const allChapters = await getCollection('chapters');
  const chapters = publishedEntries(allChapters, INCLUDE_DRAFTS);
  // Listed chapters only. A preview clone shares its subject's `chapter` tag, so
  // counting preview ids here would let a stray tag find a "match" on a page
  // nothing links to — the warning would go quiet on exactly the typo it exists
  // to report.
  const chapterIds = chapters.map((chapter) => chapter.id);

  // The one place holding every list an event tag can legitimately match, so the
  // one place that can notice a tag matching none of them. Both tags are typed
  // by hand, so a city name or a stray space passes schema validation and still
  // drops the event off every page. Community ids count as matches because the
  // `chapter` tag may name a community AND because an event now carries its own
  // `communities` list — `unmatchedChapterTags` checks both shapes.
  // Advisory only: `npm run build` gates the deploy, and refusing to publish over
  // a cosmetic typo would turn one missing event into a dead site update.
  const taggedEvents = publishedEntries(await getCollection('events'), INCLUDE_DRAFTS);
  const communityIds = publishedEntries(
    await getCollection('communities'),
    INCLUDE_DRAFTS,
  ).map((community) => community.id);
  const orphanTags = unmatchedChapterTags(
    taggedEvents.map((event) => event.data),
    [...chapterIds, ...communityIds],
  );
  if (orphanTags.length > 0) {
    console.warn(
      `[chapters] ${orphanTags.length} event chapter tag(s) match no chapter or community ` +
        `and will appear on no page: ${orphanTags.map((tag) => JSON.stringify(tag)).join(', ')}. ` +
        `Use the slug (the filename without .md) — one of: ${[...chapterIds, ...communityIds].join(', ')}.`,
    );
  }

  // Routes come from the ROUTABLE list, which adds preview pages on top of the
  // listed ones — a preview link 404s unless its page is built here.
  return routableEntries(allChapters, INCLUDE_DRAFTS).map((chapter) => ({
    params: { slug: chapter.id },
    props: { chapter },
  }));
}

type Props = { chapter: CollectionEntry<'chapters'> };
const { chapter } = Astro.props as Props;
const { Content } = await render(chapter);
const {
  city,
  region,
  blurb,
  heroImage,
  tagline,
  showGallery,
  photos,
  leads,
  links,
  status,
  callouts,
  whatsappFormUrl,
  volunteerUrl,
} = chapter.data;

// Events tagged to this chapter (via `chapter`, or via an event's `communities`
// list). Events with no tag belong to no chapter and are excluded.
//
// Both halves of the split are used now: what is coming up, and the last few
// that happened. A chapter between events used to render as a blank page.
const events = publishedEntries(await getCollection('events'), INCLUDE_DRAFTS);
const { upcoming, past } = splitEvents(eventsTaggedTo(events, chapter.id));
const recent = recentPastEvents(past);

// The shared inbox, but only because `formingChapter` is on the approved list
// in `contact.ts`. A chapter that is not forming never renders it.
const formingContactEmail = emailFor('formingChapter', settings.contactEmail);
---

<BaseLayout
  title={city}
  description={blurb ?? `Harvard Alumni in Tech ${city} chapter.`}
  noindex={isPreview(chapter)}
>
  {
    isLocked(chapter) ? (
      <LockedPreviewBody ciphertext={chapter.body ?? ''} lock={chapter.data.previewLock ?? ''} />
    ) : (
      <ChapterPage
        name={city}
        region={region}
        blurb={blurb}
        heroImage={heroImage}
        tagline={tagline}
        showGallery={showGallery}
        photos={photos}
        events={upcoming}
        pastEvents={recent}
        status={status}
        callouts={callouts}
        whatsappFormUrl={whatsappFormUrl}
        volunteerUrl={volunteerUrl}
        formingContactEmail={formingContactEmail}
        leads={leads}
        links={links}
      >
        <Content />
      </ChapterPage>
    )
  }
</BaseLayout>
