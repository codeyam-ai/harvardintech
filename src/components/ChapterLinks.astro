---
// A chapter's call-to-action buttons (volunteer, host, city socials), rendered
// as the shared `.btn.btn-solid` pills. Renders nothing when there are no
// links, so a chapter without city links simply omits the section.
//
// CMS links are usually root-relative (`/volunteer`), so each goes through
// `withBase` to resolve under the project-subpath deploy. Outside links pass
// through `withBase` unchanged and open in a new tab.
import { externalLinkAttrs } from '../lib/externalLink';
import { withBase } from '../lib/url';

interface ChapterLink {
  label: string;
  url: string;
}
interface Props {
  links?: ChapterLink[];
}
const { links = [] } = Astro.props;
---

<style>
  .chapter-links {
    margin-top: var(--s-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
</style>

{
  links.length > 0 ? (
    <div class="chapter-links">
      {links.map((link) => (
        <a
          class="btn btn-solid"
          href={withBase(link.url)}
          {...externalLinkAttrs(link.url, Astro.url.origin)}
        >
          {link.label}
        </a>
      ))}
    </div>
  ) : null
}
