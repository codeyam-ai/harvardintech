---
// "Our chapters" (Atlas): a five-across row of photo cards with a crimson
// gradient wash, each linking to its chapter page. Renders the `chapters`
// content collection passed from the homepage; an empty list shows a quiet
// prompt (production starts empty). Photos render as <img> for proxy-safe
// loading, matching the other sections.
import GlobalCommunityCta from '../GlobalCommunityCta.astro';
import EmptyState from '../ui/EmptyState.astro';
import SectionHead from '../ui/SectionHead.astro';
import { siteLinks } from '../../lib/site';
import { withBase } from '../../lib/url';
import { altFor, readMediaManifest } from '../../lib/media';
import { byPresence, chapterStatus, presenceSummary } from '../../lib/localPresence';

interface ChapterLike {
  slug: string;
  city: string;
  blurb?: string;
  heroImage?: string;
  order?: number;
  status?: string;
}
interface Props {
  chapters?: ChapterLike[];
  /** Band copy, editable per-entry in the CMS. Each defaults to the wording
   *  this band shipped with, so an entry that sets none looks unchanged. */
  heading?: string;
  kicker?: string;
  intro?: string;
}
const {
  chapters = [],
  heading = 'Our chapters',
  kicker = 'A global community',
  intro,
} = Astro.props as Props;
// Active cities first, then the ones forming — the same order the nav dropdown
// uses, so the row and the menu never disagree about which city comes first.
const sorted = byPresence(chapters);
const { activeCount, formingCount } = presenceSummary(chapters);
// The kicker counts the cities that actually hold events, and names the forming
// ones separately. Counting all six as "cities" was the claim that made "6
// global chapters" wrong everywhere else on the site.
const count = String(activeCount).padStart(2, '0');
// Read the library once for the whole row rather than per card.
const media = readMediaManifest();
---

<section class="sec" id="chapters">
  <div class="wrap">
    <SectionHead kicker={kicker} title={heading} intro={intro}>
      {
        sorted.length > 0 && (
          <span class="kick">
            {count} cities{formingCount > 0 ? ` · ${formingCount} forming` : ''}
          </span>
        )
      }
    </SectionHead>

    {
      sorted.length === 0 ? (
        <EmptyState
          title="Chapters are coming soon."
          body="Sign up for the mailing list to hear when one launches near you."
          actionHref={siteLinks().mailingList}
          actionLabel="Join the mailing list"
        />
      ) : (
        <div class="chap">
          {sorted.map((c) => (
            <a class="c" href={withBase(`/chapters/${c.slug}`)}>
              {c.heroImage && (
                <img class="pho" src={withBase(c.heroImage)} alt={altFor(c.heroImage, '', media)} />
              )}
              <div class="c-meta">
                {chapterStatus(c) === 'forming' && (
                  <span class="badge">Forming · help lead it</span>
                )}
                <span class="cn">{c.city}</span>
                {c.blurb && <span class="cb">{c.blurb}</span>}
              </div>
            </a>
          ))}
        </div>
      )
    }
  </div>
</section>

{
  /* Where the Japan and L.A. cards used to be. Those two were listed as
     chapters long after they stopped running anything, which left the row
     making a promise the site could not keep. Replacing them with the global
     community is the honest version of the same offer: there IS somewhere to
     go if your city is not on the list, and it is not a city. */
}
<GlobalCommunityCta />

<style>
  /* Three across, so six chapters read as two even rows rather than a row of
     five with one stranded card beneath it. The wider cell earns a taller card:
     at ~1/3 of the wrap the photo has room to be a photo, and the city name and
     blurb sit on one line each instead of wrapping. */
  .chap {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .c {
    position: relative;
    height: 300px;
    overflow: hidden;
    border-radius: 12px;
    color: var(--white);
    display: block;
    background: var(--ink);
    text-decoration: none;
  }
  .c:hover {
    text-decoration: none;
  }
  .pho {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .c::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 38%, rgba(124, 20, 36, 0.55), rgba(20, 16, 17, 0.9));
  }
  .c-meta {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  /* Sits above the city name rather than over the photo: the cards are
     photographic and a floating pill competes with whatever is in the image,
     while here it reads as part of the same caption block. */
  .badge {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink, #141011);
  }
  .cn {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--white);
  }
  .cb {
    font-family: var(--font-serif);
    font-size: 13px;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.85);
  }
  @media (max-width: 900px) {
    .chap {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .chap {
      grid-template-columns: 1fr;
    }
  }
</style>
