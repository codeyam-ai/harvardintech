+++ b/node_modules/@codeyam/cms/src/components/admin/CopyWarningsSummary.tsx
@@ -0,0 +1,31 @@
+// The one-line roll-up of copy warnings above the entry editor's Save button —
+// where the editor's eyes are when they decide to save — naming every field
+// that carries a CopyWarningNote further up the form. Says outright that Save
+// still works, because the amber notes are advice and must not read as a gate.
+// Renders nothing when no field is flagged.
+interface Props {
+  /** The flagged fields' display labels, in form order. */
+  labels: string[];
+}
+
+export default function CopyWarningsSummary({ labels }: Props) {
+  if (labels.length === 0) return null;
+  return (
+    <p
+      role="status"
+      data-copy-warning-summary
+      style={{
+        margin: 0,
+        padding: '0.6rem 0.8rem',
+        borderRadius: 'var(--radius-sm, 6px)',
+        border: '1px solid var(--color-warning, #9a6700)',
+        background: 'var(--color-warning-bg, #fff8c5)',
+        fontSize: '0.85rem',
+      }}
+    >
+      <strong>Check the wording before you publish.</strong>{' '}
+      {labels.length === 1 ? 'One field uses' : `${labels.length} fields use`} wording this site has
+      retired: {labels.join(', ')}. You can still save.
+    </p>
+  );
+}
