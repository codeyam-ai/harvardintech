---
// Luma calendar block for the Events page. Luma is Harvard Alumni in Tech's
// event platform. Two
// modes, driven by props:
//  • embedUrl set  → render the calendar inline as an <iframe> (the true embed),
//    followed by a subscribe strip pointing at the public calendar. The embed
//    alone is NOT enough: Luma's embed shows upcoming events and offers no
//    "subscribe" affordance of its own, so without the strip a visitor who
//    wants the calendar in their own app has nowhere to go.
//  • embedUrl empty → render a branded card linking out to the public calendar
//    (calendarUrl) so visitors can browse and subscribe on Luma.
// Both are real integrations; the card is the honest default until the embed
// snippet (cal-id) is available. When neither url is set it shows a fallback.
import LumaSubscribe from './LumaSubscribe.astro';

interface Props {
  calendarUrl?: string;
  embedUrl?: string;
  title?: string;
  height?: number;
}
const {
  calendarUrl,
  embedUrl,
  title = 'Full events calendar',
  height = 560,
} = Astro.props as Props;
---

<section class="luma s-section" id="calendar">
  <div class="s-inner">
    <div class="luma-head">
      <h2 class="s-title--plain">{title}</h2>
      <p class="luma-lede">
        Everything coming up, across every chapter, live from our Luma calendar.
      </p>
    </div>

    {
      embedUrl ? (
        <Fragment>
          <div class="luma-frame">
            <iframe
              class="luma-iframe"
              src={embedUrl}
              title="Harvard Alumni in Tech events on Luma"
              width="100%"
              height={height}
              allowfullscreen
            />
          </div>
          {calendarUrl ? <LumaSubscribe calendarUrl={calendarUrl} /> : null}
        </Fragment>
      ) : calendarUrl ? (
        <div class="luma-card">
          <div class="luma-card-copy">
            <h3>Browse & subscribe on Luma</h3>
            <p>
              Our full calendar of upcoming events lives on Luma. Subscribe to get
              every new event, across all chapters, straight to your calendar.
            </p>
          </div>
          <a class="btn btn-solid" href={calendarUrl} rel="noopener" target="_blank">
            View &amp; subscribe on Luma →
          </a>
        </div>
      ) : (
        <div class="luma-empty">
          <p>
            Our live calendar will appear here once connected to Luma. In the
            meantime, browse upcoming and past events below.
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  /* What Luma actually leaves us to design with.
     The embed is a third-party iframe: we cannot touch a pixel inside it, it
     ships its own light card with its own rounding and padding, and it does NOT
     report its content height (no postMessage), so the frame height is ours to
     choose and the calendar scrolls inside it. That leaves exactly three levers
     — the frame's WIDTH, its HEIGHT and the chrome AROUND it — and the previous
     version worked against all three: a 640px box at full page width, wrapped in
     our own bordered rectangle. With one event in the calendar that read as a
     small card marooned in a large empty box, inside a second box.

     So: hold the calendar to the same 920px column the event cards below it use,
     size the frame to the viewport instead of a fixed 640, and let Luma's own
     card be the only card. */
  .luma-head {
    margin-bottom: 20px;
    text-align: center;
  }
  .luma-head h2 {
    margin: 0;
  }
  .luma-lede {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 48ch;
    margin: 10px auto 0;
  }
  .luma-frame {
    position: relative;
    width: 100%;
    /* The same measure as the event-card grid below, so the calendar reads as
       part of the page rather than a full-bleed panel bolted to the top. */
    max-width: 920px;
    margin: 0 auto;
  }
  .luma-iframe {
    display: block;
    width: 100%;
    /* Tracks the viewport rather than sitting at a fixed 640: tall enough on a
       laptop to show several events, short enough on a small screen that the
       calendar is not the entire first screenful. The floor keeps two rows and
       Luma's own header visible at the smallest sizes.

       Deliberately sized nearer the LOW end of what the calendar can hold. The
       org usually has one or two events in flight, and Luma pads the rest of
       its panel with flat grey — so an over-tall frame reads as a half-empty
       box every quiet week, while a short one only costs a scroll on the rare
       busy one. Raise the ceiling if the calendar starts running fuller. */
    height: clamp(340px, 46vh, 540px);
    border: 0;
    /* Luma's panel has its own rounded corners; this only clips the scroll
       area to match so the two edges agree. */
    border-radius: 8px;
  }
  .luma-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    flex-wrap: wrap;
    border: 1px solid var(--line);
    border-left: 3px solid var(--crimson);
    border-radius: 6px;
    background: var(--paper-2);
    padding: 32px 34px;
  }
  .luma-card-copy h3 {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 8px;
  }
  .luma-card-copy p {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0;
  }
  .luma-empty {
    border: 1px dashed var(--line);
    border-radius: 6px;
    background: var(--paper-2);
    padding: 40px 32px;
    text-align: center;
  }
  .luma-empty p {
    font-family: var(--font-serif);
    font-size: 17px;
    color: var(--ink-2);
    max-width: 52ch;
    margin: 0 auto;
  }
</style>
