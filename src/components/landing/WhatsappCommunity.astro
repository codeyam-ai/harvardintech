---
// "Communities → WhatsApp" (Atlas): the alumni WhatsApp community, presented in
// the editorial section idiom — kicker + headline, a serif lede, the join card,
// and the HIT Directory teaser. Replaces the old robin's-egg banner-graphic band.
//
// The group itself is never linked (owner, 2026-09-14): "Apply to join" goes to
// the verification form, and the admissions criteria go to their own doc.
//
// One column, read top to bottom (owner, 2026-10-15): the heading on one line,
// the lede under it, then `WhatsappJoinCard`, then `HitDirectoryTeaser`. "Apply
// to join the community" is the one thing the band asks you to do, so the join
// card is the only white surface and the teaser stays unfilled and in ink.
import { WHATSAPP_CRITERIA_URL, WHATSAPP_FORM_URL } from '../../lib/contact';
import WhatsappJoinCard from './WhatsappJoinCard.astro';
import HitDirectoryTeaser from './HitDirectoryTeaser.astro';

interface DirectoryTeaser {
  title: string;
  text: string;
}

interface Props {
  criteriaUrl?: string;
  verifyUrl?: string;
  /** The HIT Directory teaser; `null` hides it (the band as it was). */
  directoryTeaser?: DirectoryTeaser | null;
}
const {
  // The admissions criteria doc, and the alumni-verification Google Form that
  // is also how you apply — matching the original site's WhatsApp copy.
  criteriaUrl = WHATSAPP_CRITERIA_URL,
  verifyUrl = WHATSAPP_FORM_URL,
  directoryTeaser = {
    title: 'The HIT Directory',
    text: 'Find fellow alumni and ask for an introduction without leaving WhatsApp. Open to every member of the community.',
  },
} = Astro.props as Props;
---

<section class="sec" id="community" style="background: var(--paper-2);">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="kick">Communities</span>
        <h2>Join our WhatsApp community</h2>
      </div>
    </div>
    <p class="wa-lede">
      A space for Harvard Alumni in Tech: founders, operators, and investors
      across industries, connecting in real time, anywhere in the world.
    </p>

    <div class="wa-join-slot">
      <WhatsappJoinCard verifyUrl={verifyUrl} criteriaUrl={criteriaUrl} />
    </div>

    {directoryTeaser && (
      <div class="wa-dir-slot">
        <HitDirectoryTeaser title={directoryTeaser.title} text={directoryTeaser.text} />
      </div>
    )}
  </div>
</section>

<style>
  /* The lede follows the heading directly, so the head's standing bottom gap
     (sized for a head above content) gives way to the lede's own top margin. */
  .sec-head {
    margin-bottom: 0;
  }
  .wa-lede {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-2);
    margin: 14px 0 0;
    max-width: 60ch;
  }
  /* The band owns the spacing between its parts; the parts own none. */
  .wa-join-slot {
    margin-top: 36px;
  }
  .wa-dir-slot {
    margin-top: 28px;
  }
</style>
