---
// The head of a volunteer project's detail page: the way back to the grid, the
// project title, its time commitment, and the blurb as a lede.
//
// Rendered through the shared `ui/PageBanner.astro`, in its PAPER tone. Not the
// photo tone, deliberately: the project's own photo sits in a band directly
// above this one and is shown UNCROPPED (`object-fit: contain`), because the
// detail page is the only place the image an editor picked is seen in full.
// Pulling it in as a banner background would crop it to a letterbox and defeat
// that, so the two stay separate bands.
//
// Everything but the title is optional, matching the card and the collection
// schema — an organizer can post a project the moment it opens and fill in the
// commitment and blurb later, and the header must not leave holes when they do.
import PageBanner from '../ui/PageBanner.astro';
import VolunteerProjectMeta from './VolunteerProjectMeta.astro';
import { withBase } from '../../lib/url';

interface Props {
  title: string;
  blurb?: string;
  commitment?: string;
  /** When the project runs. Rendered by the same `VolunteerProjectMeta` the card
   *  uses, so the two surfaces cannot show one project's dates two ways. */
  startDate?: string | Date;
  endDate?: string | Date;
  backHref?: string;
  backLabel?: string;
}
const {
  title,
  blurb,
  commitment,
  startDate,
  endDate,
  backHref = '/volunteer#projects',
  backLabel = '← All volunteer projects',
} = Astro.props as Props;
---

<PageBanner label="Volunteer project" title={title} lede={blurb}>
  <div class="meta-row">
    <VolunteerProjectMeta commitment={commitment} startDate={startDate} endDate={endDate} />
  </div>
  <a class="link-more back" href={withBase(backHref)}>{backLabel}</a>
</PageBanner>

<style>
  /* `:not(:has(*))` collapses the wrapper when the component rendered nothing —
     a project with neither a commitment nor a date must leave no hole under its
     title, which is the same "no holes" contract the header has always had.

     `flex`, not the default `block`: a block wrapper puts the component's output
     next to the whitespace text nodes around it, and the resulting anonymous
     line box adds a few stray pixels under the row. */
  .meta-row {
    display: flex;
    margin-top: var(--s-3);
  }
  .meta-row:not(:has(*)) {
    display: none;
  }
  .back {
    display: inline-block;
    margin-top: var(--s-4);
  }
</style>
