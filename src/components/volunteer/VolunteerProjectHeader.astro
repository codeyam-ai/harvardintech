---
// The head of a volunteer project's detail page: the way back to the grid, the
// project title, its time commitment, and the blurb as a lede.
//
// Rendered through the shared `ui/PageBanner.astro`. Which tone depends on
// whose photo it would be:
//
//  - The project has its OWN `image` → PAPER tone. That photo sits in a band
//    directly above this one and is shown UNCROPPED (`object-fit: contain`),
//    because the detail page is the only place the image an editor picked is
//    seen in full. Pulling it in as a banner background would crop it to a
//    letterbox and defeat that, so the two stay separate bands.
//  - No own image but a `backdrop` (the role's chapter photo, or the shared
//    site photo) → PHOTO tone with the backdrop behind the title. A borrowed
//    photo is atmosphere, not something the editor picked, so cropping it is
//    fine — and it beats an empty paper band.
//
// Everything but the title is optional, matching the card and the collection
// schema — an organizer can post a project the moment it opens and fill in the
// commitment and blurb later, and the header must not leave holes when they do.
import PageBanner from '../ui/PageBanner.astro';
import VolunteerProjectMeta from './VolunteerProjectMeta.astro';
import { withBase } from '../../lib/url';

interface Props {
  title: string;
  blurb?: string;
  /** The project's own photo. Only its presence matters here: it keeps the
   *  banner on paper so the uncropped photo band above stays the one view. */
  image?: string;
  /** Fallback photo for the banner when there is no `image`. */
  backdrop?: string;
  commitment?: string;
  /** When the project runs. Rendered by the same `VolunteerProjectMeta` the card
   *  uses, so the two surfaces cannot show one project's dates two ways. */
  startDate?: string | Date;
  endDate?: string | Date;
  backHref?: string;
  backLabel?: string;
}
const {
  title,
  blurb,
  image,
  backdrop,
  commitment,
  startDate,
  endDate,
  backHref = '/volunteer#projects',
  backLabel = '← All volunteer projects',
} = Astro.props as Props;

const onPhoto = !image && !!backdrop;
---

<PageBanner
  label="Volunteer project"
  title={title}
  lede={blurb}
  tone={onPhoto ? 'photo' : 'paper'}
  image={onPhoto ? backdrop : undefined}
>
  <div class:list={['meta-row', { 'on-photo': onPhoto }]}>
    <VolunteerProjectMeta commitment={commitment} startDate={startDate} endDate={endDate} />
  </div>
  <a class:list={['link-more', 'back', { 'on-photo': onPhoto }]} href={withBase(backHref)}
    >{backLabel}</a
  >
</PageBanner>

<style>
  /* `:not(:has(*))` collapses the wrapper when the component rendered nothing —
     a project with neither a commitment nor a date must leave no hole under its
     title, which is the same "no holes" contract the header has always had.

     `flex`, not the default `block`: a block wrapper puts the component's output
     next to the whitespace text nodes around it, and the resulting anonymous
     line box adds a few stray pixels under the row. */
  .meta-row {
    display: flex;
    margin-top: var(--s-3);
  }
  .meta-row:not(:has(*)) {
    display: none;
  }
  .back {
    display: inline-block;
    margin-top: var(--s-4);
  }
  /* On the photo scrim the crimson and grey of the paper tone disappear, so the
     framing line and the back link invert like the banner's own lede. */
  .meta-row.on-photo :global(.commit) {
    color: var(--white);
  }
  .meta-row.on-photo :global(.dates) {
    color: rgba(255, 255, 255, 0.8);
  }
  .back.on-photo {
    color: rgba(255, 255, 255, 0.92);
  }
  .back.on-photo:hover {
    color: var(--white);
  }
</style>
