index 0000000..ca82585
--- /dev/null
+++ b/node_modules/@codeyam/cms/src/lib/copyWarnings.ts
@@ -0,0 +1,83 @@
+// Site-declared copy warnings: wording the site does not want in its copy, said
+// to the editor as they type rather than discovered after publishing.
+//
+// A rule is plain data in `collections.json` (`copyWarnings`), the same way a
+// field's `pattern` is, so the site's own tests can import the identical rule
+// instead of keeping a second copy of the regex. Unlike `pattern` it never
+// blocks a save: wording is a judgement the editor makes, and a quoted old name
+// in a history post can be exactly right.
+//
+// Web addresses are stripped before matching — a URL or slug that spells the
+// old wording is an address, not copy, and cannot be "fixed" without breaking
+// the link. `fs`-free and DOM-free so it runs in the editor island and in tests.
+import type { FieldDef, RawFieldValue } from './entryEditor';
+
+export interface CopyWarningRule {
+  /** Regex source, compiled as written with the `g` flag added. */
+  pattern: string;
+  /** What the editor reads beside the matched wording: the right form, and why. */
+  message: string;
+}
+
+export interface CopyWarning {
+  /** The wording exactly as it appears in the text. */
+  found: string;
+  message: string;
+}
+
+const URL_RE = /https?:\/\/\S+/g;
+
+function compile(rule: CopyWarningRule): RegExp | null {
+  try {
+    return new RegExp(rule.pattern, 'g');
+  } catch {
+    // A rule that will not compile costs that one rule, not the editor.
+    return null;
+  }
+}
+
+/** Every match of every rule in `text`, URLs ignored, each wording once. */
+export function findCopyWarnings(rules: CopyWarningRule[], text: string): CopyWarning[] {
+  const stripped = text.replace(URL_RE, '');
+  const out: CopyWarning[] = [];
+  for (const rule of rules) {
+    const re = compile(rule);
+    if (!re) continue;
+    for (const found of stripped.match(re) ?? []) {
+      if (!out.some((w) => w.found === found)) out.push({ found, message: rule.message });
+    }
+  }
+  return out;
+}
+
+/** Warnings per field name (plus `body`) for one entry's form state. A list
+ * field is checked across all of its rows' text. */
+export function entryCopyWarnings(
+  rules: CopyWarningRule[],
+  fields: FieldDef[],
+  values: Record<string, RawFieldValue>,
+  body: string,
+): Record<string, CopyWarning[]> {
+  if (rules.length === 0) return {};
+  const out: Record<string, CopyWarning[]> = {};
+  for (const field of fields) {
