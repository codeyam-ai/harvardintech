---
// The narrow content block a chapter page and a community page both end with:
// a back link, the markdown body, the leads, and the entry's own links.
//
// It was written twice — once in `ChapterPage`, once in `CommunityPage` — when
// communities got their own page type. The two copies differed only in the
// heading over the leads and the wording of the back link, which is exactly the
// kind of near-identical pair that drifts: a spacing fix or an accessibility
// fix applied to one silently leaves the other behind.
//
// Renders NOTHING when there is no back-of-page content at all, so a sparse
// entry does not leave an empty bordered box on the page.
import ChapterLeads from './ChapterLeads.astro';
import ChapterLinks from './ChapterLinks.astro';
import { withBase } from '../lib/url';
import type { Lead } from '../lib/leadSchema';

interface PageLink {
  label: string;
  url: string;
}
interface Props {
  backHref: string;
  backLabel: string;
  leads?: Lead[];
  /** "Chapter leads" for a city, "Community lead(s)" for a group. */
  leadsHeading?: string;
  /** A line under the leads, e.g. "We're looking for a co-lead". */
  leadsNote?: string;
  links?: PageLink[];
  /**
   * Whether the markdown body has content.
   *
   * Passed in rather than detected with `Astro.slots.has('default')`, which
   * cannot answer the question from in here: the parent forwards its own
   * `<slot />` into this component's slot, so the slot is always "filled" from
   * this side even when the page it came from has no body at all. Only the
   * parent can see whether the ORIGINAL slot had anything in it.
   */
  hasBody?: boolean;
}
const {
  backHref,
  backLabel,
  leads = [],
  leadsHeading,
  leadsNote,
  links = [],
  hasBody = false,
} = Astro.props;

const leadsVisible = leads.length > 0;
const hasContent = leadsVisible || links.length > 0 || hasBody;
---

{
  hasContent ? (
    <section class="sec">
      <div class="wrap wrap--narrow">
        <a class="link-more back" href={withBase(backHref)}>
          {backLabel}
        </a>

        {/* The body is the entry's own "about" line, so it introduces the page
            and the leads follow it; below a full lead profile it read as an
            orphaned caption. */}
        <div class="narrow-body">
          <slot />
        </div>

        {leadsVisible ? <ChapterLeads leads={leads} heading={leadsHeading} note={leadsNote} /> : null}

        <ChapterLinks links={links} />
      </div>
    </section>
  ) : null
}

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--s-5);
  }
  .narrow-body {
    line-height: 1.8;
  }
  .narrow-body:not(:empty) {
    margin-bottom: var(--s-5);
  }
</style>
