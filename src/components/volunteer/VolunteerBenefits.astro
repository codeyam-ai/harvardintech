---
// "Why Volunteer with Harvard Alumni in Tech?" — the benefits grid.
import VolunteerBenefit from './VolunteerBenefit.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Props {
  title?: string;
  benefits?: { title: string; body: string }[];
}
const { title, benefits = [] } = Astro.props as Props;
---

{
  benefits.length > 0 ? (
    <section class="sec benefits">
      <div class="wrap">
        {title ? <SectionHead title={title} /> : null}
        <div class="grid">
          {benefits.map((b) => (
            <VolunteerBenefit title={b.title} body={b.body} />
          ))}
        </div>
      </div>
    </section>
  ) : null
}

<style>
  .benefits {
    border-bottom: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-top: 36px;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
