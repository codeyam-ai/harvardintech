---
// The campaign's pill-shaped giving CTA, per the Momentum Fund mockup — or,
// while the campaign is closed, the note that stands in for it.
//
// Its own component because the page renders it in several bands, and all of
// them must agree on both questions: whether there is a button at all
// (`isGivingOpen`) and where it goes (`resolveGiveHref`). Routing every giving
// CTA through here is what makes "the campaign has not opened yet" a single CMS
// field rather than a decision each band takes for itself.
import { isGivingOpen, resolveGiveHref } from '../../lib/giving';
import GivingSoonNote from './GivingSoonNote.astro';

interface Props {
  label?: string;
  donateUrl?: string;
  email: string;
  campaignName?: string;
  /** `light` inverts to a white button for use on the crimson/ink bands.
   *  `navy` is the campaign page's closing button, which sits on a PALE band
   *  where both the crimson and the white variant lose their footing. */
  variant?: 'crimson' | 'light' | 'navy';
  /** Appends the campaign design's ↗ glyph. Decorative and `aria-hidden`, so
   *  the link still reads as its label alone to a screen reader. */
  glyph?: boolean;
  /** Set on the dark bands so the closed-campaign note inverts to white. The
   *  button itself does not need this — a crimson pill reads on both — but
   *  plain text does, and every band that renders one knows which it is. */
  onDark?: boolean;
  /** Set where the band's own copy already announces the campaign, so the note
   *  shows only its link instead of repeating that sentence. */
  messageAlreadyShown?: boolean;
  /** Vestigial. It used to pick between linking to /give and leaving for the
   *  platform; now a closed campaign renders no link at all and an open one
   *  always goes straight to the platform, so both answers are the same. Kept
   *  only because the unused /give components still pass it, and they stay
   *  untouched pending the decision to delete them outright. */
  checkout?: boolean;
}
const {
  label = 'Make a Gift',
  donateUrl,
  email,
  campaignName,
  variant = 'crimson',
  glyph = false,
  onDark = false,
  messageAlreadyShown = false,
} = Astro.props as Props;

// One question first: can the site take a gift at all?
//
// While `donateUrl` is blank the answer is no, and the honest thing to render is
// the note rather than a button. There is no `withBase` here any more: an open
// campaign always resolves to an absolute platform URL, which must never be
// prefixed, and the closed case renders no link.
const open = isGivingOpen(donateUrl);
const href = open ? resolveGiveHref({ donateUrl, email, campaignName }) : undefined;
---

{
  open ? (
    <a
      class:list={['give', variant === 'light' && 'give--light', variant === 'navy' && 'give--navy']}
      href={href}
      rel="noopener"
    >
      {label}{glyph ? <span class="glyph" aria-hidden="true">↗</span> : null}
    </a>
  ) : (
    <GivingSoonNote onDark={onDark} showMessage={!messageAlreadyShown} />
  )
}

<style>
  .give {
    display: inline-block;
    background: var(--crimson);
    color: #fff;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    padding: 18px 42px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .give:hover {
    background: var(--crimson-deep);
    text-decoration: none;
    transform: translateY(-1px);
  }
  .give--light {
    background: #fff;
    color: var(--crimson);
  }
  .give--light:hover {
    background: rgba(255, 255, 255, 0.9);
  }
  .give--navy {
    background: var(--momentum-navy);
    color: #fff;
  }
  .give--navy:hover {
    background: var(--momentum-navy-2);
  }
  .glyph {
    margin-left: 10px;
  }
</style>
