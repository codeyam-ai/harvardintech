              "components": {
                "text1": {
                  "type": "RichText",
                  "id": "f_1b8207ec-ac24-48d8-ad94-0907201707fe",
                  "defaultValue": false,
                  "alignment": null,
                  "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\"><span style=\"color: #555555;\"><strong>Join the Harvard in Tech Volunteer Team</strong></span></p></div>",
                  "backupValue": null,
                  "version": 1,
                  "lineAlignment": {
                    "firstLineTextAlign": null,
                    "lastLineTextAlign": null
                  },
                  "defaultDataProcessed": true
                },
                "text2": {
                  "type": "RichText",
                  "id": "f_ae714d9c-5665-4c0d-97a2-7e140ed6bcef",
                  "defaultValue": false,
                  "alignment": null,
                  "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\"><span style=\"color: #000000;\">Harvard in Tech is 100% volunteer-run. Our volunteers are the heart of HIT’s mission, connecting and empowering the Harvard tech community and beyond.</span></p></div>",
                  "backupValue": null,
                  "version": 1,
                  "lineAlignment": {
                    "firstLineTextAlign": null,
                    "lastLineTextAlign": null
                  },
                  "defaultDataProcessed": true
                },
                "button1": {
                  "type": "Button",
                  "id": "f_12c43b11-f46e-4898-b602-3e06d1e43575",
                  "defaultValue": true,
