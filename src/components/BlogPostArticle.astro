---
// One blog post's article body: title, date, the rendered markdown, and the
// optional third-party embed that follows it.
//
// Extracted out of `src/pages/blog/[slug].astro`, which renders its own `<html>`
// shell and was the last of the five routed collections still holding raw
// section markup in the page file. The rendered markdown arrives as the default
// slot rather than as a prop, because `<Content />` is the component
// `render(entry)` hands back — it has to be composed by the caller that awaited
// it, not reconstructed here.
//
// Deliberately knows nothing about previews. Whether an entry is a locked
// preview decides WHICH body renders, and that decision belongs to
// `BlogPostBody` above it — this component's job is that one entry renders the
// same way whatever route reached it.
//
// The `data-cms-*` attributes are the /admin live preview's contract. Without
// them the preview patched this page "by shape": the title happened to match,
// but the date never updated, because the page shows "October 21, 2026" and
// never the raw `2026-10-21` being edited. Marked, the preview writes each field
// into the element that renders it. The body marker wraps the slot ALONE — a
// body patch replaces everything inside it, and the embed must survive that.
import Embed from './Embed.astro';
import PageBanner from './ui/PageBanner.astro';
import { formatLongDate } from '../lib/dates';

interface Props {
  /** The entry's id (its file stem). Names the entry for the live preview, so a
   *  page without one renders unmarked. */
  slug?: string;
  title: string;
  /** Published date. Formatted here so every post agrees on the format. */
  date: Date;
  /** Optional embed after the body — a video, a form, a third-party widget. */
  embedUrl?: string;
  embedHtml?: string;
}

const { slug, title, date, embedUrl, embedHtml } = Astro.props as Props;
---

<article data-cms-entry={slug ? `blog/${slug}` : undefined}>
  <PageBanner label="Blog" title={title} titleField="title">
    <time class="post-date" datetime={date.toISOString()} data-cms-field="date">
      {formatLongDate(date)}
    </time>
  </PageBanner>

  <div class="wrap wrap--narrow post-body">
    <div data-cms-body>
      <slot />
    </div>
    <Embed embedUrl={embedUrl} embedHtml={embedHtml} title={title} />
  </div>
</article>

<style>
  .post-date {
    display: block;
    margin-top: var(--s-3);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--banner-muted, var(--ink-3));
  }
  /* The reading measure itself is `.wrap--narrow` (tokens.css); only the band's
     own spacing and prose leading are local. */
  .post-body {
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
    line-height: 1.8;
  }
</style>
