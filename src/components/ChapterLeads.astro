---
// The "Chapter Leads" block: a heading and a wrapped list of named leads with
// optional roles. Renders nothing when there are no leads, so a chapter with no
// leads listed simply omits the section.
interface Lead {
  name: string;
  role?: string;
}
interface Props {
  leads?: Lead[];
  /** The heading over the list. "Chapter Leads" is right for a city and wrong
   *  for a group, so a community page passes "Community Lead" instead. */
  heading?: string;
}
const { leads = [], heading = 'Chapter Leads' } = Astro.props;
---

<style>
  .leads {
    margin-bottom: var(--s-6);
  }
  /* The heading reuses `.kick` — the site's one eyebrow — rather than restating
     mono/uppercase/tracking inline, which is what it did before and what made
     it a fourth spelling of the same label. */
  .leads .kick {
    display: block;
    margin: 0 0 var(--s-3);
  }
  .leads-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
  }
  .lead-role {
    display: block;
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
</style>

{
  leads.length > 0 ? (
    <div class="leads">
      <h2 class="kick">{heading}</h2>
      <ul class="leads-list">
        {leads.map((lead) => (
          <li>
            <strong>{lead.name}</strong>
            {lead.role ? <span class="lead-role">{lead.role}</span> : null}
          </li>
        ))}
      </ul>
    </div>
  ) : null
}
