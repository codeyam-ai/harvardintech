---
// The closing ask. When an inquiry form exists it is the one way in: a sponsor's
// details arrive structured, and the shared inbox stays out of the way (the
// owner's "sparingly" rule, 2026-09-15). Until then the button emails the shared
// inbox, one of the few places it is shown (`emailFor` in src/lib/contact.ts).
// With no form and no address at all, the button falls back to the site's
// LinkedIn, so the section never offers a dead link.
//
// The form is delegated to a third-party provider (EmbedForm), since a static
// build cannot process a submission. With no form URL configured, EmbedForm
// renders its unconfigured fallback, which reads as an obvious placeholder
// rather than a broken form — the honest state until a real form exists.
import EmbedForm from '../EmbedForm.astro';
import { sponsorCta } from '../../lib/contact';
import { externalLinkAttrs } from '../../lib/externalLink';
import { settings } from '../../lib/site';

interface Props {
  title?: string;
  body?: string;
  formUrl?: string;
  /** The shared inbox, when this surface may show it (`emailFor('sponsorInquiry', …)`). */
  email?: string;
  disclaimer?: string;
}
const {
  title = 'Start a conversation',
  body,
  formUrl,
  email,
  disclaimer,
} = Astro.props as Props;

// Which button the section offers — form, then the shared inbox, then LinkedIn —
// is decided by `sponsorCta`, so the rule is unit-tested rather than only
// provable by rendering this page.
const linkedIn = settings.socials.find((s) => s.icon === 'linkedin' || /linkedin/i.test(s.label));
const cta = sponsorCta(formUrl, email, linkedIn?.url);
---

<section class="sec" id="inquire">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="kick">Get in touch</span>
        <h2>{title}</h2>
      </div>
    </div>

    <div class="inq">
      <div class="inq-copy">
        {body ? <p class="inq-body">{body}</p> : null}
        {
          cta ? (
            <a class="btn btn-solid" href={cta.href} {...externalLinkAttrs(cta.href, Astro.url.origin)}>
              {cta.label}
            </a>
          ) : null
        }
        {
          disclaimer ? (
            <p class="inq-disclaimer">{disclaimer}</p>
          ) : null
        }
      </div>
      <div class="inq-form">
        <EmbedForm
          embedUrl={formUrl}
          title="Sponsorship inquiry"
          buttonLabel="Send"
          fallbackMessage="Our sponsorship inquiry form is on the way. In the meantime, reach us using the button on the left and we will pick it up from there."
        />
      </div>
    </div>
  </div>
</section>

<style>
  .inq {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
  }
  .inq-body {
    margin: 0 0 var(--space-md);
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .inq-disclaimer {
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    color: var(--color-faint);
    font-size: 0.85rem;
    line-height: 1.65;
  }

  @media (max-width: 880px) {
    .inq {
      grid-template-columns: 1fr;
    }
  }
</style>
