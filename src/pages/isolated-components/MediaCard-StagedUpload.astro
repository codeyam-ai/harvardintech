---
import Component from "@codeyam/cms/components/admin/MediaCard.tsx";
import "../../styles/tokens.css";

// Isolation page for a card whose image was uploaded this session but not yet
// published — the moment an editor looks at right after uploading.
//
// The thumbnail is the assertion. A staged upload has no file on the site until
// it publishes, so its `/images/...` url 404s; the card used to render that as a
// broken image, which editors read as "the upload did nothing" and uploaded
// again — the byte-identical `-2` copies in `813e3b9` and `75d884d`. The card
// now shows the staged bytes inline.
//
// The staged bytes live in the CMS staging store in localStorage, and that is
// the only seam `imageSrc` reads. So the inline script below seeds one staged
// image before the island hydrates, and puts back whatever the store held when
// the page is left, so a visit here never leaves a phantom upload in the real
// admin on the same origin. The island is `client:only` because a server render
// cannot see browser storage — it would emit the `/images/...` src and React
// keeps a mismatched attribute on hydration. The real admin is the same: staged
// cards only exist once the gallery has read the store in the browser.
const ASSET = {
  filename: 'nyc-skyline.svg',
  url: '/images/nyc-skyline.svg',
  alt: 'New York skyline at dusk',
  sizeBytes: 612,
};
const STAGED_BYTES =
  '';
const STAGED = [
  {
    collection: 'media',
    slug: ASSET.filename,
    path: `public/images/${ASSET.filename}`,
    title: ASSET.filename,
    original: '',
    updated: STAGED_BYTES,
    kind: 'edit',
    encoding: 'base64',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: MediaCard - Staged Upload</title>
    <script is:inline define:vars={{ staged: STAGED }}>
      const KEY = 'codeyam-cms:pending-changes';
      try {
        const prior = localStorage.getItem(KEY);
        localStorage.setItem(KEY, JSON.stringify(staged));
        addEventListener('pagehide', () => {
          if (prior === null) localStorage.removeItem(KEY);
          else localStorage.setItem(KEY, prior);
        });
      } catch {}
    </script>
  </head>
  <body style="margin: 0; background: var(--color-bg, #fff);">
    <div id="codeyam-capture" style="padding: 2rem; max-width: 260px;">
      <Component client:only="react" asset={ASSET} staged={true} />
    </div>
  </body>
</html>
