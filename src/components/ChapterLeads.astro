---
// The "Chapter leads" block: a heading, then each lead and co-lead as a full
// `LeadProfile` (Nicole's 21 Oct mockup), then committee members in the compact
// `LeadCommitteeGrid`, then an optional note. Renders nothing when there are no
// leads, so a chapter with no leads listed simply omits the section.
//
// Every line of a profile beyond the name is optional and drops out when empty,
// so the older `{ name, role }` entries still render as a name and role.
import LeadProfile from './leads/LeadProfile.astro';
import LeadCommitteeGrid from './leads/LeadCommitteeGrid.astro';
import { splitLeads } from '../lib/leads';
import type { Lead } from '../lib/leadSchema';

interface Props {
  leads?: Lead[];
  /** The heading over the list. "Chapter leads" is right for a city and wrong
   *  for a group, so a community page passes "Community lead" instead. */
  heading?: string;
  /** A line under the leads for what a list of names cannot say — "We're
   *  looking for a London co-lead". Absent → nothing renders. */
  note?: string;
}
const { leads = [], heading = 'Chapter leads', note } = Astro.props;
const { profiles, committee } = splitLeads(leads);
---

<style>
  .leads {
    margin-bottom: var(--s-6);
  }
  /* The heading reuses `.kick` — the site's one eyebrow — rather than restating
     mono/uppercase/tracking inline, which is what it did before and what made
     it a fourth spelling of the same label. */
  .leads .kick {
    display: block;
    margin: 0 0 var(--s-4);
  }
  .profiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-6);
  }
  .note {
    margin: var(--s-5) 0 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-style: italic;
  }
</style>

{
  leads.length > 0 ? (
    <div class="leads">
      <h2 class="kick">{heading}</h2>
      {profiles.length > 0 ? (
        <ul class="profiles">
          {profiles.map((lead) => (
            <LeadProfile lead={lead} />
          ))}
        </ul>
      ) : null}
      <LeadCommitteeGrid members={committee} />
      {note?.trim() ? <p class="note">{note}</p> : null}
    </div>
  ) : null
}
