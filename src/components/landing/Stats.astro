---
// Stat strip (Atlas): a hairline-ruled band of big crimson figures with mono
// labels, sitting directly under the hero. Values are a prop (CMS-editable /
// scenario-seedable); defaults reproduce the approved Atlas board.
interface Stat {
  value: string;
  label: string;
}
interface Props {
  stats?: Stat[];
}
const {
  // Kept in step with the `stats` collection, which is what actually renders in
  // production. These are the figures shown if that collection is ever empty,
  // so a stale copy here would put retired numbers ("5 global chapters") back on
  // the homepage at exactly the moment nobody is looking.
  stats = [
    { value: '8,500+', label: 'Newsletter subscribers' },
    { value: '750+', label: 'Alumni in our WhatsApp' },
    { value: '6+', label: 'Active communities' },
    { value: '150+', label: 'Events hosted' },
    { value: '10,000+', label: 'Event attendees' },
    { value: '2013', label: 'Founded' },
  ],
} = Astro.props as Props;
---

<section
  class:list={['stats', { wrap: stats.length > 5 }]}
  id="stats"
  style={`--n:${stats.length}`}
>
  {
    stats.map((s) => (
      <div class="stat">
        <div class="v">{s.value}</div>
        <div class="l">{s.label}</div>
      </div>
    ))
  }
</section>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(var(--n, 4), 1fr);
    border-bottom: 1px solid var(--line);
  }
  .stat {
    padding: 36px 48px;
    border-left: 1px solid var(--line);
  }
  .stat:first-child {
    border-left: none;
  }
  .v {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--crimson);
    line-height: 1;
  }
  .l {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-top: 8px;
  }
  /* Five figures with 48px gutters need ~1230px; at 768–834 (iPad portrait and
     Air) the band pushed the page 1012px wide. The site's shared header
     breakpoint brings the gutters in, and the figures then fit in five columns. */
  @media (max-width: 1040px) {
    .stat {
      padding: 32px 20px;
    }
  }
  /* Six figures need ~790px of digits ("10,000+" alone is ~180px). With 48px
     gutters that is ~1370px, so a laptop-width page went sideways; 32px gutters
     bring one row down to ~1175px. Below that, two rows of three keep every
     figure whole until the phone layout's two columns take over. */
  @media (min-width: 1201px) {
    .wrap .stat {
      padding-inline: 32px;
    }
  }
  @media (min-width: 761px) and (max-width: 1200px) {
    .stats.wrap {
      grid-template-columns: repeat(3, 1fr);
    }
    .wrap .stat:nth-child(3n + 1) {
      border-left: none;
    }
    .wrap .stat:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 760px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .stat:nth-child(odd) {
      border-left: none;
    }
    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  /* At 390px two columns leave 195px each, and 48px of side padding left 99px
     of that for a 44px figure like "8,500+" that needs ~150px. A grid item's
     automatic minimum is its content, so the track could not shrink and the
     whole band pushed the page into a sideways scroll. `min-width: 0` lets the
     track shrink; the smaller padding and figure mean it no longer has to.
     This width was never reviewed before — the expanded nav hid every band
     below it (audit F1). */
  @media (max-width: 520px) {
    .stat {
      min-width: 0;
      padding: 28px 16px;
    }
    .v {
      font-size: 34px;
    }
    .l {
      letter-spacing: 0.06em;
    }
  }
</style>
