---
import Component from "../../../src/components/donate/GivingSoonNote.astro";
import "../../../src/styles/tokens.css";

// Isolation page for GivingSoonNote on a PALE band — the default tone, as the
// priorities band and the empty donor wall render it.
//
// This is the state that replaces a giving button everywhere the campaign is
// closed: the message, then the one thing a reader can actually do instead. Its
// dark-band counterpart is `GivingSoonNote-OnDark`, which exists as its own
// prerendered page because this is a static build — `?s=` query params are
// empty at build time, so one page cannot switch between the two tones.
//
// The width matches the action column the note occupies in its real bands,
// so the message wraps here the way it wraps on the page.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: GivingSoonNote</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center; background: var(--momentum-cream, #f6f1e7);">
    <div id="codeyam-capture" style="padding: var(--space-lg); width: 100%; max-width: 420px;">
      <Component />
    </div>
  </body>
</html>
