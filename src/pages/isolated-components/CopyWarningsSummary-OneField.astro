---
import Component from "@codeyam/cms/components/admin/CopyWarningsSummary.tsx";
import "../../styles/tokens.css";

// Isolation page for CopyWarningsSummary with a single flagged field — the
// singular branch of its copy ("One field uses …"), so the count never reads
// "1 fields".
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: CopyWarningsSummary - One Field</title>
  </head>
  <body style="margin: 0; background: var(--color-bg, #fff);">
    <div id="codeyam-capture" style="min-height: 100vh; padding: 1.5rem; max-width: 40rem;">
      <Component client:load labels={['Body']} />
    </div>
  </body>
</html>
