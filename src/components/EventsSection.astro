---
// A titled block of event cards: a section head, a responsive card grid, and an
// optional empty state. `variant` is passed through to each EventCard.
import EventCardGrid from './EventCardGrid.astro';
import SectionHead from './ui/SectionHead.astro';
import EmptyState from './ui/EmptyState.astro';
import type { EventLike } from '../lib/events';

interface Props {
  title: string;
  events: EventLike[];
  variant?: 'upcoming' | 'past';
  emptyMessage?: string;
}
const { title, events, variant = 'upcoming', emptyMessage } = Astro.props;
---

{/* h3, not h2: the page's banner already carries the h1 and this block sits
    under a section that owns the h2, so a second h2 here would flatten the
    outline. */}
<SectionHead title={title} as="h3" align="center" />
{
  events.length === 0 ? (
    emptyMessage ? <EmptyState title={emptyMessage} /> : null
  ) : (
    <EventCardGrid events={events} variant={variant} />
  )
}
