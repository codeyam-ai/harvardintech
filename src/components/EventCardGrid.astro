---
// A responsive grid of event cards.
//
// Its own component because the chapter events section and the /events page
// section had byte-identical copies of this grid — same six declarations, two
// class names. One of them would eventually have been tuned without the other,
// and the two surfaces would have drifted apart while looking like they shared
// a definition.
//
// Cards keep one width. Each card opens on a square cover (see EventCard), so
// stretching a lone card across the row — what this grid used to do — would
// turn its cover into a 900px square. Three 280px tracks fit the 920px column.
//
// The block of tracks is centred in the column, and a short last row (two of
// five cards) lines up under the left-hand cards rather than centring on its
// own (owner, 2026-10-14). `auto-fit` collapses unused tracks, so a page with
// only one or two cards in total still sits centred.
import EventCard from './EventCard.astro';
import type { EventLike } from '../lib/events';

interface Props {
  events: EventLike[];
  variant?: 'upcoming' | 'past';
}
const { events, variant = 'upcoming' } = Astro.props as Props;
---

<div class="event-grid">
  {events.map((event) => <EventCard event={event} variant={variant} />)}
</div>

<style>
  .event-grid {
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(auto-fit, minmax(240px, 280px));
    justify-content: center;
    max-width: 920px;
    margin: 0 auto;
  }
  /* On a phone the 280px column ceiling left ~40px of white either side of a
     single card; let the one column take the full width instead. */
  @media (max-width: 600px) {
    .event-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
