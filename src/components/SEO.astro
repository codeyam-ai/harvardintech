---
// Per-page <head> meta: title, description, canonical, Open Graph + Twitter
// card tags. Defaults come from the editable `settings` singleton so every
// page is consistent; pages override per-route via props. Rendered inside the
// base layout's <head>. (Site-level sitemap.xml / robots.txt live in the
// deploy-hardening stack, not here — this component owns the per-page tags.)
import { settings } from '../lib/site';
import { canonicalFor, canonicalOrigin } from '../lib/canonicalUrl';
import { absoluteImageUrl, DEFAULT_OG_IMAGE, DEFAULT_OG_IMAGE_SIZE } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  /**
   * Keep this page out of search results. Set by preview pages, whose whole
   * premise is an unlisted URL — an indexed preview publishes the token it
   * exists to hide.
   *
   * This cannot be left to `PreviewGate`, which also emits `noindex`: the gate
   * is OFF on the public track by design, so a preview that reached `main`
   * would be indexable with nothing to stop it. The gate covers the review
   * ORIGIN; this covers the PAGE, on whichever track it is built.
   */
  noindex?: boolean;
}

const { title, description, image, canonical, noindex } = Astro.props;

// A page title becomes "Page · Site"; the bare site title is the home/default.
const pageTitle = title ? `${title} · ${settings.siteTitle}` : settings.siteTitle;
const metaDescription = description ?? settings.description;
// The canonical and og:url name the live domain, never the gated preview this
// page may be served from — see canonicalUrl.ts.
const canonicalUrl =
  canonical ??
  canonicalFor(
    Astro.url.pathname,
    import.meta.env.BASE_URL,
    canonicalOrigin(Astro.site, Astro.url.origin),
  );

// Share images must be absolute or the crawler drops them — see lib/seo.ts.
// Every page gets a card: one it named, else the site default.
const usingDefaultImage = !image?.trim();
const shareImage = absoluteImageUrl(
  image ?? DEFAULT_OG_IMAGE,
  Astro.site,
  import.meta.env.BASE_URL,
);
---

<title>{pageTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
{shareImage ? <meta property="og:image" content={shareImage} /> : null}
{
  shareImage && usingDefaultImage ? (
    <Fragment>
      <meta property="og:image:width" content={String(DEFAULT_OG_IMAGE_SIZE.width)} />
      <meta property="og:image:height" content={String(DEFAULT_OG_IMAGE_SIZE.height)} />
    </Fragment>
  ) : null
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={metaDescription} />
{shareImage ? <meta name="twitter:image" content={shareImage} /> : null}
