---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostBody from '../../components/BlogPostBody.astro';
import { isPreview, routableEntries } from '../../lib/drafts';
import { INCLUDE_DRAFTS } from '../../lib/draftVisibility';

// Static output needs every dynamic route enumerated at build time.
// `getStaticPaths` turns each blog entry into a pre-rendered `/blog/<id>` page.
// Content Layer entries key on `id` (the file stem) — the old `slug`.
//
// Drafts are filtered here too, not just in the listings: a draft left out of
// the index but still reachable at its own URL is public either way, which is
// worse than not supporting drafts at all. In dev and on the review track the
// page is still generated so the post can be read before it is promoted.
//
// `routableEntries` rather than `publishedEntries` because of preview links: a
// preview is deliberately absent from every listing, so this is the ONLY place
// that can build its page, and an unbuilt preview means the URL handed to a
// reviewer 404s. The listing pages keep `publishedEntries` and stay unaware of
// it — see `src/lib/drafts.ts` for why the two rules are separate.
export async function getStaticPaths() {
  const posts = routableEntries(await getCollection('blog'), INCLUDE_DRAFTS);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<'blog'> };
const { post } = Astro.props as Props;
const { Content } = await render(post);

// Per-page SEO overrides fall back to the post's own fields, then to site
// defaults inside <SEO />, which BaseLayout renders. This page used to carry its
// own <html> shell and therefore its own <SEO />, <HeadExtras /> and
// customBodyHtml injection — three copies that had to be kept in step with the
// layout by hand, and a post with no nav at all, so a reader arriving from
// search or the Medium link had no way into the rest of the site.
const seoTitle = post.data.metaTitle ?? post.data.title;
const seoDescription = post.data.metaDescription ?? post.data.summary;
const seoImage = post.data.ogImage ?? post.data.coverImage;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={seoImage}
  noindex={isPreview(post)}
>
  {/* No wrapper here: the post's banner runs full-bleed and each branch of
      `BlogPostBody` brings its own reading measure for the prose beneath it. */}
  <BlogPostBody post={post}>
    <Content />
  </BlogPostBody>
</BaseLayout>
