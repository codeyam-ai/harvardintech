---
// "Contact us" (Atlas): the closing section, set as a crimson band — kicker +
// headline, a serif invitation, and the social links as a row of circular marks
// spread across the full content width, each captioned with where it leads.
//
// The invitation sits DIRECTLY under the heading and the breathing room goes
// below it, so the line reads as part of the heading block rather than as a
// stranded caption above the links.
//
// Icons come from `brandIcons.ts` as inline SVG rather than the raster badges in
// `socialIcon.ts`: on crimson they have to be white, and the original assets are
// full-colour (one is a JPEG with a white background), so they cannot be
// recoloured — see the note in that module.
//
// WHY THIS DOES NOT USE `ui/SocialLinks.astro`, which the footer and the chapter
// Connect row both do: that part is a compact badge row. This band is the
// section's navigation — 104px outlined discs on a responsive grid, captioned
// with where each one leads, inverting to a white fill on hover. Serving both
// from one component would mean three layout modes and a hover inversion inside
// it, and the thing actually worth sharing is already shared: both read
// `connectLinks`, so they cannot disagree about which accounts exist or about
// when the e-mail disc appears. Only the presentation differs, deliberately.
import { displayConnectLinks } from '../../lib/contact';
import { externalLinkAttrs } from '../../lib/externalLink';
import BrandGlyph from '../ui/BrandGlyph.astro';
import SectionHead from '../ui/SectionHead.astro';
import type { SocialLink } from '../../lib/site';

interface Props {
  socials: readonly SocialLink[];
  /** The shared inbox, when this surface may show it (`emailFor('contactUs', …)`). */
  email?: string;
  /** Band copy, editable per-entry in the CMS. Each defaults to the wording
   *  this band shipped with, so an entry that sets none looks unchanged. */
  heading?: string;
  kicker?: string;
  intro?: string;
}
const {
  socials,
  email,
  heading = 'Contact us',
  kicker = 'Say hello',
  intro,
} = Astro.props as Props;

// The e-mail disc is synthesized from the shared inbox, one of the few places the
// owner's "sparingly" rule shows it (see `EMAIL_SURFACES` in src/lib/contact.ts).
// With no address the section offers the socials alone. An editor who already
// added a mail link as a social keeps that one instead of getting two envelopes.
const links = displayConnectLinks(socials, email);
const hasEmail = links.some((link) => link.url.trim().toLowerCase().startsWith('mailto:'));

// The default invitation names the mail option only when there IS one — an
// editor who supplies their own `intro` replaces this wholesale.
const defaultIntro = hasEmail
  ? "We'd love to hear from you. Reach out on any of these, or drop us a note."
  : "We'd love to hear from you. Reach out on any of these.";
---

<section class="sec contact" id="contact">
  <div class="wrap">
    <SectionHead kicker={kicker} title={heading} intro={intro ?? defaultIntro} />

    <div class="contact-row">
      {
        links.map((link) => {
          return (
            <a
              class="contact-link"
              href={link.url}
              aria-label={link.label}
              {...externalLinkAttrs(link.url, Astro.url.origin)}
            >
              <span class="contact-disc">
                <BrandGlyph name={link.icon} fallbackName={link.label} size={46} />
              </span>
              <span class="contact-label">{link.label}</span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--crimson);
    border-bottom: 0;
  }
  /* The section furniture is inherited from `.sec`, so only the ink changes —
     and the head's standing bottom margin is closed up, because the invitation
     now lives inside the head rather than after it. */
  .contact :global(.sec-head) {
    margin-bottom: 0;
  }
  /* All three reach INTO `SectionHead`, so all three need `:global`. Astro
     scopes a style to the component that declares the MARKUP, and the eyebrow,
     heading and intro are now that component's elements rather than this one's
     — a bare `.contact h2` silently stops matching and the band renders dark
     ink on crimson. */
  .contact :global(.kick) {
    color: rgba(255, 255, 255, 0.75);
  }
  .contact :global(h2) {
    color: var(--white);
    margin-bottom: 10px;
  }
  .contact :global(.sh-intro) {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.86);
    margin: 0;
    max-width: 52ch;
  }
  /* One track per link across the full content width: the marks are the section's
     navigation, so they get the width rather than huddling at the left margin. */
  .contact-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 28px;
    margin-top: 64px;
  }
  .contact-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-decoration: none;
    color: var(--white);
  }
  .contact-link:hover {
    text-decoration: none;
  }
  .contact-disc {
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .contact-link:hover .contact-disc {
    background: var(--white);
    color: var(--crimson);
    transform: translateY(-2px);
  }
  /* `:global`, because the glyph is `BrandGlyph`'s element and Astro scopes a
     style to the component that declares the markup. The size is restated here
     rather than left to the component's `size` prop because this band shrinks
     it at phone width, and a media query cannot reach a prop. */
  .contact-disc :global(svg) {
    display: block;
    width: 46px;
    height: 46px;
  }
  .contact-label {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-align: center;
  }
  @media (max-width: 520px) {
    .contact-row {
      gap: 20px;
    }
    .contact-disc {
      width: 84px;
      height: 84px;
    }
    .contact-disc :global(svg) {
      width: 38px;
      height: 38px;
    }
  }
</style>
