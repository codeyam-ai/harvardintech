---
import Component from "../../../src/components/ui/SocialLinks.astro";
import "../../../src/styles/tokens.css";

// Isolation page for SocialLinks — codeyam screenshots the #codeyam-capture
// wrapper by navigating to /isolated-components/SocialLinks.
//
// The ON-LIGHT variant, as the chapter and community Connect rows render it:
// each mark in its own brand colour on a white badge. The on-dark variant the
// footer uses has its own page, since a prerendered stack cannot switch state
// from a query parameter.
//
// The accounts come from `settings.json` through `connectLinks`, so this
// capture shows the real roster rather than a fixture — which is the point of
// the component: the footer, the Contact band and every chapter row read the
// same list and therefore cannot disagree about which accounts exist.
//
// No `email` is passed, so the envelope is absent. That is the owner's rule
// (2026-09-15): the shared inbox appears sparingly, and a Connect row is not
// one of the surfaces that shows it.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: SocialLinks</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: var(--space-lg);">
      <Component variant="on-light" size={24} />
    </div>
  </body>
</html>
