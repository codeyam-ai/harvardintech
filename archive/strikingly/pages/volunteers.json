              }
            },
            {
              "type": "RepeatableItem",
              "id": "f_6b8e6fa7-d104-4877-bbc5-579a2645cb82",
              "defaultValue": true,
              "components": {
                "text1": {
                  "type": "RichText",
                  "id": "f_80dff627-7e1e-420d-b57d-4968281a44e0",
                  "defaultValue": false,
                  "alignment": null,
                  "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\"><span style=\"color: #555555;\"><strong>Why Volunteer with Harvard in Tech?</strong></span></p></div>",
                  "backupValue": null,
                  "version": 1,
                  "lineAlignment": {
                    "firstLineTextAlign": null,
                    "lastLineTextAlign": null
                  },
                  "defaultDataProcessed": true
                },
                "text2": {
                  "type": "RichText",
                  "id": "f_62bba0a8-cfc7-4647-8c31-3c6d6d365eb3",
                  "defaultValue": false,
                  "alignment": null,
                  "value": "<div class=\"s-rich-text-wrapper\" style=\"display: block; \"><p class=\" s-rich-text-wrapper\"><span style=\"color: #000000;\"><strong>✅ </strong></span><span style=\"color: #000000;\">Gain Valuable Experience: Work on impactful projects showcasing leadership, creativity, and technical skills.</span></p><p class=\" s-rich-text-wrapper\">Engage in high-impact projects that allow you to showcase your leadership, creativity, and technical expertise. Whether you're designing innovative solutions, managing strategic initiatives, or contributing to team-driven goals, you'll develop real-world experience that sets you apart in today’s competitive tech landscape.</p><p class=\" s-rich-text-wrapper\"><br><span style=\"color: #000000;\">✅ Expand Your Network: Connect with Harvard alumni and professionals in tech.</span></p><p class=\" s-rich-text-wrapper\">Build meaningful connections with Harvard alumni and accomplished professionals across the tech industry. From thought leaders and entrepreneurs to engineers and product managers, you’ll join a vibrant community where networking leads to mentorship, collaboration, and career opportunities.</p><p class=\" s-rich-text-wrapper\"><br><span style=\"color: #000000;\">✅ Make a Difference: Contribute to innovation, technology, and community growth.</span></p><p class=\" s-rich-text-wrapper\"> Be a part of something bigger and contribute your time and talent to initiatives that drive innovation, foster community engagement, and support the responsible growth of technology. Your impact will be felt not only within the Harvard in Tech ecosystem but also across broader communities where technology can create positive change.</p><p class=\" s-rich-text-wrapper\"><br><span style=\"color: #000000;\">✅ Enhance Your Resume: Demonstrate commitment to the Harvard tech community.</span></p><p class=\" s-rich-text-wrapper\">Stand out to future employers by demonstrating your active involvement and leadership within the Harvard in Tech community. Your contributions reflect a strong commitment to innovation, collaboration, and continuous learning—qualities that top companies are looking for in today’s dynamic job market.</p></div>",
                  "backupValue": null,
                  "version": 1,
                  "lineAlignment": {
                    "firstLineTextAlign": null,
                    "lastLineTextAlign": null
                  },
                  "defaultDataProcessed": true
                },
