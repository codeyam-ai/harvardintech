---
// Full Events page body: an intro header, the recent "Past Events" cards, the
// folded 2013-2019 archive, and a line out to the webinar recordings. Split
// from a single flat `events` array against `now` (build time on the static
// site) via the pure splitEvents / splitArchive helpers. Accepts a plain array
// so it renders from getCollection() on the /events route and from
// isolated-component scenarios (rich / archive-only / empty states).
//
// There is NO "Upcoming" list here. The Luma calendar embed sits directly above
// this body on /events and is the live, always-current answer to "what's next";
// a second upcoming list underneath it showed the same events twice, from a
// source that only refreshes when the site is rebuilt (owner, 2026-09-14).
// Past events are the opposite case — Luma does not keep them, so this page is
// the only place they exist.
import EventsIntro from './EventsIntro.astro';
import EventsSection from './EventsSection.astro';
import EventsArchive from './EventsArchive.astro';
import PastEventsMore from './PastEventsMore.astro';
import WebinarsPointer from './WebinarsPointer.astro';
import { splitEvents, splitArchive, type EventLike } from '../lib/events';
import { siteLinks } from '../lib/site';

// No Eventbrite button: Luma is the one events system (owner, 2026-09-14), and
// the Luma calendar sits above this body on /events.
interface Props {
  events?: EventLike[];
  now?: string | Date;
  /**
   * Render the page's own title and standfirst.
   *
   * The /events route turns this OFF and renders EventsIntro itself, above the
   * Luma calendar — otherwise the page opens on the embed's heading instead of
   * its own. It defaults to on so this component still stands alone in the
   * isolated-component scenarios, which capture the body away from the route.
   */
  showIntro?: boolean;
}
const { events = [], now, showIntro = true } = Astro.props;

const { past } = splitEvents(events, now ?? new Date());
const { recent, archive } = splitArchive(past);
---

<section class="sec">
  <div class="wrap">
    {showIntro ? <EventsIntro /> : null}

    {
      recent.length > 0 ? (
        <EventsSection title="Past Events" events={recent} variant="past" />
      ) : null
    }

    {recent.length > 0 ? <PastEventsMore calendarUrl={siteLinks().luma} /> : null}

    <EventsArchive events={archive} />

    <WebinarsPointer />
  </div>
</section>
