---
// "Focus areas" (Atlas): the site's main program categories as entry points —
// Programs, Chapters, Communities, Content Hub, Membership. Categories are a
// prop so the CMS can reorder/relabel them; defaults mirror the approved
// taxonomy.
//
// Laid out as a ROW LIST rather than five cards. The five areas are a directory,
// not a set of equal-weight features: a reader scans down the names looking for
// the one they want, and a row gives the name, the one-line explanation and the
// way in on a single line at that scanning width. Five narrow cards made each
// blurb wrap to three lines and buried the link at the bottom of each column.
import { withBase } from '../../lib/url';
import { areaIcon } from '../../lib/areaIcons';
import BrandGlyph from '../ui/BrandGlyph.astro';
import SectionHead from '../ui/SectionHead.astro';

interface Area {
  label: string;
  blurb: string;
  url: string;
  /** Overrides the label-derived glyph when an area is renamed to something the
   *  icon table cannot resolve. */
  icon?: string;
}
interface Props {
  areas?: Area[];
  /** How many chapters are published, so the Chapters blurb counts them rather
   *  than asserting a number that goes stale the next time one launches. The
   *  homepage passes `chapters.length`; absent (an isolated render, or a caller
   *  that supplies its own `areas`) falls back to wording with no count in it. */
  chapterCount?: number;
  /** Band copy, editable per-entry in the CMS. Each defaults to the wording
   *  this band shipped with, so an entry that sets none looks unchanged. */
  heading?: string;
  kicker?: string;
  intro?: string;
}
// `chapterCount` is destructured BEFORE `areas` so the default blurb below can
// read it — a later default may reference an earlier binding.
const {
  chapterCount,
  areas = [
    // "podcasts" was dropped: the org runs none, and naming one on the homepage
    // promises a thing a visitor then cannot find. Webinars stay — the old site
    // ran them through 2020 and the history plan restores that archive.
    { label: 'Programs', blurb: 'Events and webinars across the year.', url: '/events/' },
    {
      label: 'Chapters',
      // Was hard-coded to "Five" and had been wrong since SF Bay Area launched.
      blurb: chapterCount
        ? `Chapters in ${chapterCount} ${chapterCount === 1 ? 'city' : 'cities'}, and growing.`
        : 'City communities, and growing.',
      url: '/#chapters',
    },
    { label: 'Communities', blurb: 'Our alumni WhatsApp network.', url: '/#community' },
    {
      label: 'Content hub',
      // "Our blog" went with the blog itself. The Content hub band this row
      // points at now offers Medium, LinkedIn and the newsletter, so naming a
      // blog here promised a destination the visitor lands on and cannot find —
      // the same reason "podcasts" left the Programs row above. Put the blog
      // back in this sentence when `BLOG_ENABLED` goes back to true.
      blurb: 'Our Medium publication, LinkedIn, and newsletter.',
      url: '/#content',
    },
    { label: 'Membership', blurb: 'About, get involved, and support the mission.', url: '/#get-involved' },
  ],
  heading = 'Focus areas',
  kicker = 'Explore',
  intro,
} = Astro.props as Props;
---

<section class="sec" id="focus">
  <div class="wrap">
    <SectionHead kicker={kicker} title={heading} intro={intro} />

    <div class="fa-list">
      {
        areas.map((a) => {
          const icon = areaIcon(a.icon) ?? areaIcon(a.label);
          return (
            <a class="fa" href={a.url.startsWith('http') ? a.url : withBase(a.url)}>
              <span class="fa-disc">
                <BrandGlyph icon={icon} size={26} />
              </span>
              <span class="fa-l">{a.label}</span>
              <span class="fa-b">{a.blurb}</span>
              <span class="link-more fa-go">Explore →</span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .fa-list {
    display: flex;
    flex-direction: column;
  }
  /* Four tracks: mark, name, explanation, way in. The name column is fixed so
     the explanations start on one vertical line down the list — that shared
     edge is what makes the rows scannable. */
  .fa {
    display: grid;
    grid-template-columns: 58px 200px 1fr auto;
    align-items: center;
    gap: 26px;
    padding: 20px 8px;
    border-top: 1px solid var(--line);
    text-decoration: none;
    color: var(--ink);
    transition: background 0.15s ease;
  }
  .fa:last-child {
    border-bottom: 1px solid var(--line);
  }
  .fa:hover {
    text-decoration: none;
    background: var(--paper-2);
  }
  .fa-disc {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: 1.5px solid var(--crimson);
    color: var(--crimson);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .fa:hover .fa-disc {
    background: var(--crimson);
    color: var(--white);
  }
  /* `:global`, because the glyph is `BrandGlyph`'s element — see the same note
     on the Contact band. */
  .fa-disc :global(svg) {
    display: block;
    width: 26px;
    height: 26px;
  }
  .fa-l {
    font-size: 19px;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .fa:hover .fa-l {
    color: var(--crimson);
  }
  .fa-b {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  /* Type and colour come from `.link-more` (tokens.css); the no-wrap rule is
     this row's own, so "Explore →" never breaks across two lines. */
  .fa-go {
    white-space: nowrap;
  }
  @media (max-width: 820px) {
    /* The explanation drops under the name; the mark keeps its column so the
       list still reads as a list rather than five stacked blocks. */
    .fa {
      grid-template-columns: 48px 1fr;
      gap: 8px 18px;
      padding: 18px 4px;
    }
    .fa-disc {
      width: 48px;
      height: 48px;
      grid-row: span 2;
    }
    .fa-disc :global(svg) {
      width: 22px;
      height: 22px;
    }
    .fa-go {
      grid-column: 2;
    }
  }
</style>
