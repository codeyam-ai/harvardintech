---
// "Upcoming events" (Atlas): the landing-page events section in the editorial
// idiom — a sec-head (kicker + heading), then either the event rows or the
// empty state.
//
// Events render as full-width ROWS rather than a card grid: the reading order
// an event actually has is "when, what, where", and a row lets the date sit in
// its own column at the right where the eye can scan a column of dates without
// reading each card. The date column is split month / day / year so the day
// number carries the scan weight.
//
// Empty state (production's day-one default) keeps the two subscribe paths —
// the org's Luma calendar (primary) and the mailing list (secondary).
// Its explanatory line sits INSIDE the head, directly under the heading, so it
// reads as part of the heading block rather than as a stranded caption above
// the buttons.
//
// It states the absence ONCE. A right-hand card also reading "No upcoming
// events" used to sit beside the buttons, echoing the line above it and — with
// no date column to align to in the empty state — hanging off the grid. The
// lede is the better of the two: it explains the absence AND points straight
// down at the buttons that do something about it.
import type { EventLike } from '../../lib/events';
import { siteLinks } from '../../lib/site';
import SectionHead from '../ui/SectionHead.astro';
import { eventDateParts } from '../../lib/eventDateParts';

interface Props {
  events?: EventLike[];
  lumaUrl?: string;
  newsletterUrl?: string;
  /** Band copy, editable per-entry in the CMS. Each defaults to the wording
   *  this band shipped with, so an entry that sets none looks unchanged. */
  heading?: string;
  kicker?: string;
  intro?: string;
}
const {
  events = [],
  lumaUrl = siteLinks().luma,
  newsletterUrl = siteLinks().mailingList,
  heading = 'Upcoming events',
  kicker = 'Calendar',
  intro,
} = Astro.props;

const isEmpty = events.length === 0;
const count = String(events.length).padStart(2, '0');
---

<section
  class:list={['sec', isEmpty && 'ue-section--empty']}
  id="events"
  style="background: var(--paper-2);"
>
  <div class="wrap">
    <SectionHead
      kicker={kicker}
      title={heading}
      intro={
        intro ??
        (isEmpty
          ? 'No upcoming events just yet. Subscribe to our Luma calendar to be the first to know when the next one is announced.'
          : undefined)
      }
    >
      {!isEmpty && <span class="kick">{count} scheduled</span>}
    </SectionHead>

    {
      isEmpty ? (
        <div class="ue-cta ue-cta-empty">
          <a class="btn btn-solid" href={lumaUrl} rel="noopener" target="_blank">
            Subscribe to our Luma calendar
          </a>
          <a class="btn btn-out" href={newsletterUrl} rel="noopener">
            Subscribe to our newsletter
          </a>
        </div>
      ) : (
        <Fragment>
          <div class="ue-list">
            {events.map((event) => {
              const { month, day, year } = eventDateParts(event.date);
              return (
                <article class="ue-row">
                  <div class="ue-body">
                    {event.location && <span class="ue-where">{event.location}</span>}
                    <h3 class="ue-title">
                      {event.link ? (
                        <a href={event.link} rel="noopener">
                          {event.title}
                        </a>
                      ) : (
                        event.title
                      )}
                    </h3>
                    {event.description && <p class="ue-blurb">{event.description}</p>}
                    {event.link && (
                      <a class="link-more ue-go" href={event.link} rel="noopener">
                        Learn more →
                      </a>
                    )}
                  </div>
                  <div class="ue-date">
                    <span class="ue-m">{month}</span>
                    <span class="ue-d">{day}</span>
                    <span class="ue-y">{year}</span>
                  </div>
                </article>
              );
            })}
          </div>
          <div class="ue-cta" style="margin-top: 28px;">
            <a class="btn btn-solid" href={lumaUrl} rel="noopener" target="_blank">
              View full calendar on Luma
            </a>
          </div>
        </Fragment>
      )
    }
  </div>
</section>

<style>
  /* ---- populated ------------------------------------------------------- */
  .ue-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ue-row {
    display: grid;
    grid-template-columns: 1fr 150px;
    align-items: center;
    gap: 24px;
    background: var(--white);
    border: 1px solid var(--line);
    border-left: 3px solid var(--crimson);
    padding: 22px 26px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .ue-row:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(30, 26, 27, 0.1);
  }
  .ue-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .ue-where {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .ue-title {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    margin: 0;
  }
  .ue-title a {
    color: inherit;
    text-decoration: none;
  }
  .ue-title a:hover {
    color: var(--crimson);
    text-decoration: none;
  }
  .ue-blurb {
    font-family: var(--font-serif);
    font-size: 15px;
    line-height: 1.45;
    color: var(--ink-2);
    margin: 2px 0 0;
    max-width: 62ch;
  }
  /* Type and colour come from `.link-more` (tokens.css); only this row's
     spacing is local. */
  .ue-go {
    margin-top: 4px;
  }
  /* The date column reads as one stacked unit, divided from the body by the
     same hairline the card is drawn with rather than a second, heavier rule. */
  .ue-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    border-left: 1px solid var(--line);
    padding-left: 24px;
    text-align: center;
  }
  .ue-m {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.1;
    color: var(--ink-2);
  }
  .ue-d {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--crimson);
  }
  .ue-y {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--ink-2);
  }

  /* ---- empty ----------------------------------------------------------- */
  /* The lede lives in the head, so the head's standing 40px gap would sit
     between heading and lede. Closed up here and re-spent below the lede, which
     is where the separation actually belongs. */
  .ue-section--empty :global(.sec-head) {
    margin-bottom: 0;
  }
  /* One row of buttons under the lede, not a two-column grid: with the
     right-hand panel gone there is no second column to balance, and 52px of
     air separated the lede from the buttons it was pointing at. */
  .ue-cta-empty {
    margin-top: 28px;
  }

  .ue-cta {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .ue-row {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .ue-date {
      flex-direction: row;
      align-items: baseline;
      justify-content: flex-start;
      gap: 8px;
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: 14px;
    }
    .ue-d {
      font-size: 32px;
    }
    .ue-cta-empty {
      margin-top: 22px;
    }
    .ue-cta {
      gap: 16px;
    }
  }
</style>
