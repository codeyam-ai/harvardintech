---
// The /sponsor page header. Now a thin adapter over `ui/PageBanner.astro` —
// the same banner chapters, communities, /events, volunteer and site pages
// render — so the sponsorship page reads as part of the site rather than as a
// page with a hero of its own.
//
// It used to centre its text over a full-bleed photo and fall back to a plain
// crimson band with no image. The banner's paper tone replaces that fallback,
// and the text is left-aligned like every other page header (owner,
// 2026-09-14).
import PageBanner from '../ui/PageBanner.astro';

interface Props {
  kicker?: string;
  headline: string;
  intro?: string;
  image?: string;
}
const { kicker, headline, intro, image } = Astro.props as Props;
---

<PageBanner
  label={kicker}
  title={headline}
  lede={intro}
  image={image}
  tone={image ? 'photo' : 'paper'}
/>
