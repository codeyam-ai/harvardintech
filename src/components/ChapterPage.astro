---
// A single regional chapter page, recomposed to match the live harvardintech.com
// chapter pages: a full-bleed city hero, a teal "Sign Up" band, the narrow
// content block (back link + leads + markdown body + links), an optional event
// photo gallery, and a "Connect With Us" social footer. Accepts plain props so
// it renders from the /chapters/<slug> route (with rendered <Content /> in the
// slot) and from isolated scenarios (NYC with hero/gallery, sparse Japan with no
// hero → centered-header fallback).
import ChapterHero from './ChapterHero.astro';
import ChapterEvents from './ChapterEvents.astro';
import ChapterSignUp from './ChapterSignUp.astro';
import ChapterConnect from './ChapterConnect.astro';
import CommunityCallouts from './CommunityCallouts.astro';
import PageNarrowBody from './PageNarrowBody.astro';
import FormingChapterCta from './FormingChapterCta.astro';
import GlobalCommunityCta from './GlobalCommunityCta.astro';
import EventGallery from './landing/EventGallery.astro';
import type { EventLike } from '../lib/events';
import { isForming } from '../lib/localPresence';
import { bannerFor } from '../lib/pageBanner';

interface Lead {
  name: string;
  role?: string;
}
interface ChapterLink {
  label: string;
  url: string;
}
interface Props {
  /** Who the page is about: a chapter's city, or a community's name. Named
   *  neutrally because this shell now renders both — `city={name}` at a
   *  community call site would read as a mistake. */
  name: string;
  region?: string;
  blurb?: string;
  heroImage?: string;
  tagline?: string;
  showGallery?: boolean;
  /**
   * This surface's own curated photos. Absent or EMPTY falls back to the shared
   * 40-photo gallery, which is what every chapter showed before this existed —
   * so a chapter nobody has curated looks exactly as it did.
   *
   * /communities renders this same shell and deliberately never passes it,
   * which is what keeps community pages byte-for-byte unchanged.
   */
  photos?: { image?: string; caption?: string }[];
  events?: EventLike[];
  /** Heading over the events list. Defaults to "Upcoming Events in <name>",
   *  which reads wrong for a community ("...in Founders") — /communities passes
   *  its own phrasing. */
  eventsHeading?: string;
  /**
   * The last few events that already happened, most recent first.
   *
   * A chapter with nothing on the calendar this month looked identical to one
   * that had never run anything. Showing what it recently did is the cheapest
   * possible proof that it is real — and it is why a quiet active chapter is
   * still worth visiting.
   */
  pastEvents?: EventLike[];
  /**
   * `active` or `forming`; absent means active.
   *
   * A forming (WhatsApp-only) city renders just its hero and the "meets online
   * for now" band with its three asks. Everything else on this page belongs to
   * active chapters. Its URL and menu entry stay the same either way.
   */
  status?: string;
  /** "What happens here" cards, for a chapter whose calendar is thin. */
  callouts?: { title: string; text?: string }[];
  /** The entry's own WhatsApp form override. Always a form, never a group. */
  whatsappFormUrl?: string;
  leads?: Lead[];
  links?: ChapterLink[];
  /** Where the "back" link at the top of the content block points, and what it
   *  says. Defaults to the chapters row on the home page; a community page
   *  points at the community section instead. */
  backHref?: string;
  backLabel?: string;
}
const {
  name,
  region,
  blurb,
  heroImage,
  tagline,
  showGallery = true,
  photos,
  events = [],
  eventsHeading,
  pastEvents = [],
  status,
  callouts = [],
  whatsappFormUrl,
  leads = [],
  links = [],
  backHref = '/#events',
  backLabel = '← All chapters',
} = Astro.props;

const forming = isForming({ status });
// The kicker over the banner title. Derived in `lib/pageBanner.ts` so the
// chapter page, the community page and the CMS hints cannot spell the same
// label three ways.
const { label: heroLabel } = bannerFor({ kind: 'chapter', status, name });

// Detected HERE, not inside PageNarrowBody: that component receives this page's
// `<slot />` forwarded into its own, which always reads as filled from in there.
// See its `hasBody` prop.
const hasBody = Astro.slots.has('default');
---

<ChapterHero
  name={name}
  region={region}
  blurb={blurb}
  heroImage={heroImage}
  tagline={tagline}
  label={heroLabel}
/>

{
  /* A forming (WhatsApp-only) city is the hero plus this one band and nothing
     else: the owner wants three asks and no filler. Everything below is the
     active-chapter page. */
  forming ? (
    <FormingChapterCta name={name} whatsappFormUrl={whatsappFormUrl} />
  ) : (
    <Fragment>
      <ChapterEvents events={events} name={name} heading={eventsHeading} />
      <CommunityCallouts callouts={callouts} />
      <ChapterEvents events={pastEvents} name={name} variant="past" />
      <ChapterSignUp name={name} />
      <PageNarrowBody
        backHref={backHref}
        backLabel={backLabel}
        leads={leads}
        links={links}
        hasBody={hasBody}
      >
        <slot />
      </PageNarrowBody>
      {
        /* An empty `photos` list is treated as absent, not as "an empty gallery":
           the CMS leaves an empty array behind when an editor removes the last
           row. `cap` is passed ONLY here; the landing page stays uncapped. */
        showGallery ? (
          photos?.length ? (
            <EventGallery photos={photos} cap={12} heading={`Photos from ${name}`} />
          ) : (
            <EventGallery />
          )
        ) : null
      }
      {/* Every active chapter page ends by offering the way in that needs no
          chapter at all, for a visitor who is not near this city. */}
      <GlobalCommunityCta />
      <ChapterConnect />
    </Fragment>
  )
}
