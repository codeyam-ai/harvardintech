---
// The /volunteer page header: the "Join the Volunteer Team" pitch and the
// primary sign-up CTA.
//
// Now the shared `ui/PageBanner.astro`, with the CTA passed through its slot.
// The photo treatment it used to carry (a 104px-tall band with its own gradient
// scrim and an 82px headline) was a third hero treatment on a site that now has
// one; the banner supplies the tone, the scrim and the type.
import PageBanner from '../ui/PageBanner.astro';
import { externalLinkAttrs } from '../../lib/externalLink';
import { withBase } from '../../lib/url';

interface Props {
  kicker?: string;
  headline: string;
  intro: string;
  ctaLabel?: string;
  ctaUrl?: string;
  /** Full-bleed background photo. */
  image?: string;
}
const { kicker, headline, intro, ctaLabel, ctaUrl, image } = Astro.props as Props;
---

<PageBanner
  label={kicker}
  title={headline}
  lede={intro}
  image={image}
  tone={image ? 'photo' : 'paper'}
>
  {
    ctaLabel && ctaUrl ? (
      <p class="vh-cta">
        <a
          class="btn btn-solid"
          href={withBase(ctaUrl)}
          {...externalLinkAttrs(ctaUrl, Astro.url.origin)}
        >
          {ctaLabel}
        </a>
      </p>
    ) : null
  }
</PageBanner>

<style>
  .vh-cta {
    margin: var(--s-4) 0 0;
  }
</style>
