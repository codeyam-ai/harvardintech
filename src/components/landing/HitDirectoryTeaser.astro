---
// The HIT Directory teaser under the WhatsApp join card (owner, 2026-10-15).
//
// A TEASER, one more reason to join: it says the directory exists inside the
// community and nothing more. No access number, no keyword, no link. That waits
// for the full launch, and a WhatsApp link would break the band's
// never-link-the-group rule.
//
// Unfilled, on the band's own ground, divided only by a hairline and set in ink
// rather than crimson: present and named, but a step below the join card, so it
// never competes with the Apply button.
interface Props {
  title: string;
  text: string;
}
const { title, text } = Astro.props;
---

<div class="wa-dir">
  <div>
    <div class="wa-dir-head">
      <span class="kick wa-dir-kick">Inside the community</span>
      <span class="wa-dir-tag">Beta</span>
    </div>
    <h3 class="wa-dir-title">{title}</h3>
  </div>
  <p class="wa-dir-text">{text}</p>
</div>

<style>
  .wa-dir {
    padding: 24px 4px 0;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: minmax(260px, auto) 1fr;
    column-gap: 48px;
    align-items: center;
  }
  .wa-dir-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .wa-dir-kick {
    color: var(--ink-2);
  }
  .wa-dir-tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--ink-3);
    padding: 2px 7px 1px;
  }
  .wa-dir-title {
    font-family: var(--font-title);
    font-size: 24px;
    line-height: 1.15;
    font-weight: 700;
    color: var(--ink);
    margin: 8px 0 0;
  }
  .wa-dir-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 52ch;
  }
  @media (max-width: 820px) {
    .wa-dir {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
