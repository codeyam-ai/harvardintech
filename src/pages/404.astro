---
// The not-found page. It used to render its own bare <html> shell with inline
// styles and no nav, which made it the one page a lost reader could reach with
// no way onward. Rendering it through BaseLayout is the whole fix: the header,
// the footer and the webfonts arrive with the shell, so "go back home" is the
// backstop rather than the only exit.
//
// Note for anyone verifying this page from a capture: the screenshot harness
// cannot photograph it, because it refuses an HTTP 404 response (responsive
// audit §6). Check it by navigating a browser to any unrouted path.
import BaseLayout from '../layouts/BaseLayout.astro';
import NotFound from '../components/NotFound.astro';
---

<BaseLayout
  title="Page not found — 404"
  description="The page you are looking for does not exist."
  noindex
>
  <NotFound />
</BaseLayout>
