@@ -0,0 +1,29 @@
+// The inline "this wording is off" note beneath a field. FieldError's sibling,
+// in a caution colour rather than danger, because a copy warning never blocks
+// a save. Renders nothing when there is nothing to say.
+import type { CSSProperties } from 'react';
+import type { CopyWarning } from '../../lib/copyWarnings';
+
+export const copyWarningStyle: CSSProperties = {
+  margin: '0.35rem 0 0',
+  fontSize: '0.78rem',
+  fontWeight: 600,
+  color: 'var(--color-warning, #9a6700)',
+};
+
+interface Props {
+  warnings?: CopyWarning[];
+}
+
+export default function CopyWarningNote({ warnings }: Props) {
+  if (!warnings || warnings.length === 0) return null;
+  return (
+    <>
+      {warnings.map((w) => (
+        <p key={w.found} style={copyWarningStyle} data-copy-warning>
+          ⚠ “{w.found}” — {w.message}
+        </p>
+      ))}
+    </>
+  );
+}
diff --git a/node_modules/@codeyam/cms/src/components/admin/CopyWarningsSummary.tsx b/node_modules/@codeyam/cms/src/components/admin/CopyWarningsSummary.tsx
