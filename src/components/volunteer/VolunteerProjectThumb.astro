---
// A project card's thumbnail. Three branches, in priority order:
//   1. the project's own `image`, shown plain;
//   2. a `backdrop` — a borrowed photo (the role's chapter photo, or the shared
//      site photo), rendered by VolunteerProjectBackdrop under a crimson wash;
//   3. neither → the gradient placeholder (isolated scenarios that pass no
//      backdrop still render this).
//
// Fixed height and cropped on purpose — a grid mixing cards with and without
// photos has to stay aligned, so all branches occupy the same space. The
// uncropped photo lives on the detail page (VolunteerProjectPhoto).
//
// When the card links through, the thumbnail is wrapped but marked
// `aria-hidden` + `tabindex="-1"`: the title beside it already links to the same
// page, and a second identical link would give keyboard and screen-reader users
// a duplicate stop for no gain.
import { withBase } from '../../lib/url';
import { altFor } from '../../lib/media';
import VolunteerProjectBackdrop from './VolunteerProjectBackdrop.astro';

interface Props {
  image?: string;
  /** Fallback photo for a project with no `image`. Decorative. */
  backdrop?: string;
  /** Where the card links, already base-prefixed. Absent → no link. */
  href?: string;
}
const { image, backdrop, href } = Astro.props as Props;
---

{
  image ? (
    href ? (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <img class="img" src={withBase(image)} alt={altFor(image, '')} loading="lazy" />
      </a>
    ) : (
      <img class="img" src={withBase(image)} alt={altFor(image, '')} loading="lazy" />
    )
  ) : backdrop ? (
    <VolunteerProjectBackdrop src={backdrop} href={href} />
  ) : (
    <div class="img img--none" aria-hidden="true" />
  )
}

<style>
  .img {
    width: 100%;
    height: 168px;
    object-fit: cover;
    display: block;
    background: var(--paper-2);
  }
  .img--none {
    background: linear-gradient(135deg, var(--ink) 0%, var(--crimson-deep) 100%);
    opacity: 0.15;
  }
  /* The placeholder exists to keep a multi-column grid level. Both project
     grids drop to one column at 720px, where there is nothing to line up with
     and ~18 empty 168px bands made the phone page mostly blank boxes. A
     backdrop photo is real content, so it stays. */
  @media (max-width: 720px) {
    .img--none {
      display: none;
    }
  }
  .thumb {
    display: block;
  }
</style>
