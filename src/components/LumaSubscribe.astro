---
// The "subscribe to this calendar" line shown beneath the inline Luma embed.
//
// Separate from LumaCalendar because it solves a distinct problem: the embed
// renders the calendar but offers no subscribe affordance of its own, so
// without this a visitor who wants the calendar in their own app has nowhere to
// go. It is only used alongside the embed — the link-out card mode already
// carries its own subscribe call to action.
//
// A single centred line, not a boxed strip with its own button (owner,
// 2026-10-14). The primary Subscribe on Luma button now sits in the page
// banner, so this is the quiet reminder at the foot of the calendar; a second
// bordered card with a second outlined button read as a duplicate panel. Its
// link is the shared `.link-more`, the "quieter" level of the button system.
import { externalLinkAttrs } from '../lib/externalLink';

interface Props {
  calendarUrl: string;
}
const { calendarUrl } = Astro.props as Props;
---

<p class="sub">
  Get every new event, across all chapters, in your own calendar.
  <a
    class="link-more"
    href={calendarUrl}
    {...externalLinkAttrs(calendarUrl, Astro.url.origin)}
  >
    Subscribe on Luma →
  </a>
</p>

<style>
  .sub {
    max-width: 920px;
    margin: var(--s-4) auto 0;
    text-align: center;
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-3);
  }
  a {
    margin-left: 0.5em;
    white-space: nowrap;
  }
</style>
