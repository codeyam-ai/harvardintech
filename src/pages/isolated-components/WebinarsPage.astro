---
import Component from "../../../src/components/WebinarsPage.astro";
import "../../../src/styles/tokens.css";

// Isolation page for WebinarsPage — codeyam screenshots the #codeyam-capture wrapper
// by navigating to /isolated-components/WebinarsPage.

// Entries in the shape getCollection('blog') hands over. The last carries NO
// cover image, which is the real case for a recording whose video host has lost
// the upload — that card must show a plain block rather than a caption over a
// placeholder.
const posts = [
  {
    id: 'webinar-covid-19-is-telemedicine-the-future-of-health-care',
    data: {
      title: 'COVID-19: Is Telemedicine the Future of Health Care?',
      date: '2020-05-25',
      summary: 'A seven-person panel, with Harvard in Tech Seattle',
      coverImage: '/images/webinars/covid-19-is-telemedicine-the-future-of-health-care.jpg',
      series: 'webinars',
    },
  },
  {
    id: 'webinar-reopening-the-economy-during-covid-19',
    data: {
      title: 'Reopening the Economy During COVID-19',
      date: '2020-05-03',
      summary: 'Mayor Kate Gallego of Phoenix, with Harvard in Tech Seattle',
      coverImage: '/images/webinars/reopening-the-economy-during-covid-19.jpg',
      series: 'webinars',
    },
  },
  {
    id: 'webinar-cybersecurity-in-the-supply-chain',
    data: {
      title: 'Cybersecurity in the Supply Chain',
      date: '2020-05-01',
      summary: 'Jim Fleming (ISM) and Charlotte de Brabandt',
      coverImage: '/images/webinars/cybersecurity-in-the-supply-chain.jpg',
      series: 'webinars',
    },
  },
  {
    id: 'webinar-media-and-technology-in-growth-markets',
    data: {
      title: 'Media and Technology in Growth Markets',
      date: '2020-04-20',
      summary: 'Marcus Brauchli, North Base Media',
      series: 'webinars',
    },
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: WebinarsPage</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: var(--space-lg); width: 100%; max-width: 1100px;">
      <Component posts={posts} />
    </div>
  </body>
</html>
