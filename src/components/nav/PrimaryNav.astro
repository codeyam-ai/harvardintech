---
// The header's primary menu: a taxonomy mega-menu (Programs / Chapters /
// Communities / Content Hub / Membership) opened on hover or keyboard focus.
//
// Renders whatever tree it is handed, to three levels. A top-level item with no
// children is a plain link; with children it becomes a dropdown, and if any of
// those children themselves have children the panel splits into titled columns.
//
// The items come from two places: the hand-authored groups in `nav.json` (edited
// via /admin → Settings) and the Chapters group the layout DERIVES from the
// chapters collection. This component cannot tell them apart, which is the
// point — derived and authored items render identically.
//
// The panel opens with CSS alone (`:hover` / `:focus-within`) — no JS, so it
// works before hydration and for keyboard users.
//
// At 1040px and below there is no hover to open anything, so the whole menu
// collapses behind one button instead. The markup for that is a `<details open>`
// wrapping the nav: with JavaScript off the menu is present and a native summary
// collapses it, and `navDisclosure.ts` upgrades the summary to a button when
// JavaScript runs. The panels then render as flat headed lists rather than
// floating cards — which is the fix for the site's worst public defect, a phone
// or iPad where all five panels rendered open and stacked and no page showed
// any of its own content on the first screen.
//
// Outside links (the Content Hub's Medium and LinkedIn entries) open in a new
// tab through the one site-wide rule in src/lib/externalLink.ts.
import { externalLinkAttrs } from '../../lib/externalLink';
import { withBase } from '../../lib/url';
import type { NavItem } from '../../lib/site';

interface Props {
  items: NavItem[];
  /**
   * The Subscribe link, repeated as the last item in the menu.
   *
   * Only rendered at 520px and under, where the header row cannot hold the
   * wordmark, Subscribe and the menu button at once — the header drops its
   * button and this one takes over, so the call to action is never simply
   * absent on a phone.
   */
  subscribeUrl?: string;
}
const { items, subscribeUrl } = Astro.props as Props;
---

{/* The shell is `display: contents` — a wrapper that keeps the button and the
    drawer inside this component without adding a box to the header's flex row.
    It exists because `display: contents` is IGNORED on <details> (the spec
    makes it compute to `block` there), so the button cannot simply live inside
    the disclosure: it would be trapped in the drawer's full-width row and sit
    under the wordmark instead of beside it. */}
<div class="nav-shell">
  <details class="nav-drawer" open>
    <summary class="nav-summary">Menu</summary>
    <nav class="links" id="site-menu" aria-label="Primary">
  {
    items.map((item) =>
      item.children && item.children.length > 0 ? (
        <div class="nav-item">
          <button class="nav-top" type="button">
            {item.label} <span class="caret">▾</span>
          </button>
          <div class="mega">
            <div class="mega-in">
              {item.children.some((c) => c.children && c.children.length > 0) ? (
                item.children.map((group) => (
                  <div class="mega-col">
                    {group.children && group.children.length > 0 ? (
                      <Fragment>
                        <span class="mega-h">{group.label}</span>
                        {group.children.map((leaf) => (
                          <a href={withBase(leaf.url ?? '/')} {...externalLinkAttrs(leaf.url, Astro.url.origin)}>
                            {leaf.label}
                          </a>
                        ))}
                      </Fragment>
                    ) : (
                      <a
                        class="mega-h-link"
                        href={withBase(group.url ?? '/')}
                        {...externalLinkAttrs(group.url, Astro.url.origin)}
                      >
                        {group.label}
                      </a>
                    )}
                  </div>
                ))
              ) : (
                <div class="mega-col">
                  {item.children.map((child) => (
                    <a href={withBase(child.url ?? '/')} {...externalLinkAttrs(child.url, Astro.url.origin)}>
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      ) : (
        <a class="nav-top" href={withBase(item.url ?? '/')} {...externalLinkAttrs(item.url, Astro.url.origin)}>
          {item.label}
        </a>
        ),
      )
    }
      {subscribeUrl ? (
        <a class="nav-menu-cta btn btn-solid" href={subscribeUrl} rel="noopener">
          Subscribe
        </a>
      ) : null}
    </nav>
  </details>
</div>

<script>
  import { initNavDisclosure } from '../../lib/navDisclosure';

  // Astro bundles and defers this, so it runs after the markup is parsed. The
  // menu is already usable by then — this only adds the button.
  const shell = document.querySelector<HTMLElement>('.nav-shell');
  if (shell) initNavDisclosure(shell, window.matchMedia('(max-width: 1040px)'));
</script>

<style>
  .links {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 13px;
    font-weight: 600;
  }

  /* The shell adds no box of its own at any width: the header's flex row sees
     the button and the drawer, never this wrapper. */
  .nav-shell {
    display: contents;
  }

  /* Above the breakpoint the drawer is a plain wrapper: the summary and the
     button are both gone and `.links` sits in the header row exactly as it did
     before any of this existed. */
  .nav-summary {
    display: none;
  }
  /* The button is inserted by navDisclosure.ts, so it is addressed through
     :global() — a scoped selector never matches an element the server did not
     render, and the rules would silently do nothing. */
  .nav-shell :global(.nav-toggle) {
    display: none;
    align-items: center;
    gap: 9px;
    background: none;
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 9px 14px;
    min-height: 44px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
  }
  /* One element, three bars: the middle is the box, the outer two its shadows. */
  .nav-shell :global(.nav-toggle-bars) {
    width: 16px;
    height: 2px;
    background: currentColor;
    box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
  }
  /* Open is worth showing as well as announcing — `aria-expanded` alone is
     invisible to everyone not using a screen reader. */
  .nav-shell :global(.nav-toggle[aria-expanded='true']) {
    background: var(--crimson);
    border-color: var(--crimson);
    color: #fff;
  }
  .nav-item {
    position: relative;
  }
  .nav-top {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: none;
    border: 0;
    padding: 6px 0;
    margin: 0;
    font: inherit;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    text-decoration: none;
  }
  .nav-top:hover {
    color: var(--crimson);
    text-decoration: none;
  }
  .caret {
    font-size: 9px;
    color: var(--ink-3);
  }

  /* Hover mega-menu panel. */
  .mega {
    position: absolute;
    left: 50%;
    top: 100%;
    transform: translateX(-50%) translateY(6px);
    z-index: 70;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.12s ease, transform 0.12s ease;
    padding-top: 12px;
  }
  .nav-item:hover .mega,
  .nav-item:focus-within .mega {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .mega-in {
    display: flex;
    gap: 28px;
    background: #fff;
    border: 1px solid var(--line);
    border-top: 2px solid var(--crimson);
    border-radius: 4px;
    box-shadow: 0 18px 40px rgba(30, 26, 27, 0.14);
    padding: 22px 26px;
    white-space: nowrap;
  }
  .mega-col {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 140px;
  }
  .mega-h {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--crimson);
    margin-bottom: 3px;
  }
  .mega-col a {
    color: var(--ink);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
  }
  .mega-col a:hover {
    color: var(--crimson);
  }
  .mega-h-link {
    font-weight: 700 !important;
  }

  /* The header keeps its own Subscribe button until 520px, so this copy stays
     out of the way everywhere above that. */
  .nav-menu-cta {
    display: none;
  }

  /* Below the breakpoint there is no hover to open anything, so the menu moves
     to its own row under the wordmark and collapses behind the button. The
     panels render inline as flat headed lists — every group stays reachable
     without hover, but only once the visitor asks for the menu.
     The `.site-nav` half of this breakpoint lives in the layout. */
  @media (max-width: 1040px) {
    .nav-drawer {
      order: 3;
      width: 100%;
    }
    /* The no-JS control. A native summary collapses the menu on its own, which
       is why the markup ships as <details> rather than a div. */
    .nav-summary {
      display: block;
      list-style: none;
      cursor: pointer;
      padding: 12px 0;
      min-height: 44px;
      font-size: 13px;
      font-weight: 600;
    }
    .nav-summary::-webkit-details-marker {
      display: none;
    }

    /* The button sits in the header row (order 2, after the wordmark and
       Subscribe); the drawer takes a row of its own beneath all three. */
    .nav-shell :global(.nav-toggle) {
      display: inline-flex;
      order: 2;
    }

    /* `data-js` is set in <head> before first paint (BaseLayout), so the panels
       never flash open on a phone while the module loads. With JavaScript off
       neither rule applies and the native summary above is the control. */
    :global(html[data-js]) .nav-summary {
      display: none;
    }
    /* The whole drawer goes, not just the links inside it: an empty <details>
       is still a full-width flex item, and the header's 24px row gap would
       leave a band of dead space under the wordmark with nothing in it. */
    :global(html[data-js]) .nav-shell:not([data-open]) .nav-drawer {
      display: none;
    }

    .links {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      gap: 0;
      padding: 8px 0 4px;
    }
    .nav-item {
      position: static;
    }
    /* A group label becomes a heading: its panel is already open below it, so
       there is nothing left for it to toggle. */
    .nav-top {
      width: 100%;
      padding: 14px 0 4px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--crimson);
      cursor: default;
    }
    .nav-top:hover {
      color: var(--crimson);
    }
    .caret {
      display: none;
    }
    /* A top-level item with no children is still a link, so it keeps link
       sizing and a full tap target rather than being dressed as a heading. */
    a.nav-top {
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: normal;
      text-transform: none;
      color: var(--ink);
      min-height: 44px;
      padding: 0;
      cursor: pointer;
    }
    .mega {
      position: static;
      transform: none;
      padding-top: 0;
      opacity: 1;
      visibility: visible;
    }
    /* No card chrome in the drawer: this is one list, not five stacked panels. */
    .mega-in {
      display: block;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 0;
      white-space: normal;
    }
    .mega-col {
      min-width: 0;
      gap: 0;
    }
    .mega-h {
      padding: 10px 0 2px;
      margin-bottom: 0;
      color: var(--ink-3);
    }
    .mega-col a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-left: 12px;
      border-left: 2px solid var(--line);
      font-size: 15px;
    }
  }

  /* A 390px row cannot hold the wordmark, Subscribe and the menu button, so at
     this width the header drops its Subscribe and the menu carries it instead —
     as the last item, after the links, where a reader ends up anyway. */
  @media (max-width: 520px) {
    .nav-menu-cta {
      display: inline-flex;
      align-self: flex-start;
      margin-top: 16px;
    }
  }
</style>
