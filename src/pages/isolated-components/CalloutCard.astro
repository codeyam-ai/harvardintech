---
import Component from "../../components/CalloutCard.astro";
import "../../styles/tokens.css";

// One "what happens here" card on its own.
//
// Captured separately from the grid because the card is the thing with a look
// and the grid is only an arrangement of them — the same reason every other
// card on this site (GiftPillarCard, DonorCard, AccomplishmentCard) has its own
// isolation page. A change to the card's padding or rule shows here plainly,
// where in the grid frame it competes with two neighbours.
//
// Bounded to one grid cell's width rather than the viewport: the grid lays out
// on `minmax(240px, 1fr)` within the content width, so a full-bleed capture
// would show the card at a width it never actually renders at.
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Isolated: CalloutCard</title>
  </head>
  <body style="margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;">
    <div id="codeyam-capture" style="padding: var(--space-lg);">
      <div style="width: 360px;">
        <Component
          title="Bi-weekly calls with alumni globally"
          text="An open call every other week — what people are building, what is working, and what turned out not to. No agenda beyond that, and no need to be in any particular city."
        />
      </div>
    </div>
  </body>
</html>
