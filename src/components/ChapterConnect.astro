---
// "Connect With Us" from the live chapter pages: a centered heading and the
// site's social links as circular badges, each carrying the brand's official
// logo in its official colour. Reads the editable socials from the settings
// singleton so it stays CMS-editable.
//
// The logos are inline SVG from `brandIcons.ts` (the official Simple Icons
// marks), so they stay sharp on any screen. They replaced the original site's
// 100px teal raster badges, which blurred on high-density displays and still
// showed the retired Twitter bird.
//
// No email here, on purpose. The owner's rule (2026-09-15) shows the shared
// inbox "sparingly", and a chapter or community Connect row is not one of those
// places (see `EMAIL_SURFACES` in src/lib/contact.ts). Every social is listed in
// its settings order, so LinkedIn appears alongside X and Facebook.
import SectionHead from './ui/SectionHead.astro';
import SocialLinks from './ui/SocialLinks.astro';
---

<section class="sec" id="connect">
  <div class="wrap">
    <SectionHead title="Connect With Us" align="center" />
    <div class="connect-row">
      <SocialLinks variant="on-light" size={24} />
    </div>
  </div>
</section>

<style>
  /* The badges themselves live in `SocialLinks`; this only centres the row,
     which is a decision of THIS band rather than of the component — the footer
     renders the same component left-aligned. */
  .connect-row {
    display: flex;
    justify-content: center;
  }
</style>
