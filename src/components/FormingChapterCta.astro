---
// The whole body of a FORMING (WhatsApp-only) chapter page, under its hero.
//
// DC and Seattle have alumni and an active WhatsApp group but no one running
// events yet. The owner asked for these pages to be minimal: three asks and
// nothing else. Join the WhatsApp group, get the newsletter, or volunteer to
// help or co-lead the chapter. Events, write-ups and callouts belong to the
// active chapters.
import SectionHead from './ui/SectionHead.astro';
import { siteLinks, volunteerPage } from '../lib/site';
import { joinCtas, volunteerFormHref } from '../lib/localPresence';
import { loadVolunteerCopy } from '../lib/volunteerPageContent';
import { externalLinkAttrs } from '../lib/externalLink';
import { withBase } from '../lib/url';

interface Props {
  /** The city this chapter is forming in. */
  name: string;
  whatsappFormUrl?: string;
}
const { name, whatsappFormUrl } = Astro.props;

// The chapter's own override wins; otherwise the site-wide setting. Both go
// through `joinCtas`, so a group invite is refused whichever one supplied it.
const { whatsappFormUrl: formHref } = joinCtas({
  whatsappFormUrl: whatsappFormUrl ?? siteLinks().whatsappJoinForm,
});
const newsletterHref = siteLinks().mailingList;
// The volunteer interest form, edited on the Volunteer page in /admin. Read the
// same way /volunteer reads it, so the two buttons never disagree.
const volunteerHref = volunteerFormHref((await loadVolunteerCopy(volunteerPage)).ctaUrl);
// `withBase` prefixes an internal path with the base path and leaves an https
// URL untouched; `externalLinkAttrs` decides new-tab-or-not from the origin.
const origin = Astro.url.origin;
---

<section class="sec forming" id="help-lead">
  <div class="wrap">
    {/* `balance` (below, on `.forming h2`) because the heading is city-name-long
        and varies, and an unbalanced wrap strands the last word on its own line. */}
    <SectionHead
      title={`${name} meets online for now.`}
      intro={`Join our WhatsApp group to meet alumni in ${name}, plus topic-based channels and virtual meetups.`}
      align="center"
    />

    <div class="forming-actions">
      <a class="btn btn-solid" href={withBase(formHref)} {...externalLinkAttrs(formHref, origin)}>
        Request to join WhatsApp
      </a>
      <a class="btn btn-out" href={withBase(newsletterHref)} {...externalLinkAttrs(newsletterHref, origin)}>
        Subscribe to newsletter
      </a>
      <a class="btn btn-out" href={withBase(volunteerHref)} {...externalLinkAttrs(volunteerHref, origin)}>
        Volunteer or co-lead
      </a>
    </div>
  </div>
</section>

<style>
  .forming {
    background: var(--paper-2);
  }
  .forming :global(h2) {
    text-wrap: balance;
  }
  /* Wraps to one button per row on a phone rather than shrinking the labels.
     WhatsApp is the solid button because it is the main way in. */
  .forming-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    justify-content: center;
  }
</style>
