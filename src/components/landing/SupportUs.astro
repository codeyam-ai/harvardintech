---
// "Support us" (Atlas): five ways to support, as crimson-edged cards in the
// editorial grid used across the redesigned site.
//
// Every card leads to a page or a form, never an inbox (owner, 2026-09-14:
// "remove any personal emails and have CTAs go to volunteer or other appropriate
// form"). Sponsoring, hosting and job posts go to /sponsor, whose "Start a
// conversation" takes the inquiry; speaking goes to the volunteer form, whose
// URL lives in the volunteer page copy and is passed in; volunteering goes to
// /volunteer. "Ways to partner" is hidden on /sponsor for launch, so nothing
// links to `#levels`.
import { VOLUNTEER_PATH } from '../../lib/contact';
import { externalLinkAttrs } from '../../lib/externalLink';
import { withBase } from '../../lib/url';

interface Props {
  /** The volunteer form (the volunteer page's `ctaUrl`). Absent → /volunteer. */
  volunteerFormUrl?: string;
}
const { volunteerFormUrl } = Astro.props;

const toSponsor = { href: withBase('/sponsor'), cta: 'Start a conversation →' };
const options = [
  { label: 'Sponsor an event', ...toSponsor },
  { label: 'Host us in your space', ...toSponsor },
  { label: 'Share job opportunities', ...toSponsor },
  { label: 'Speak at an event', href: volunteerFormUrl ?? withBase(VOLUNTEER_PATH), cta: 'Volunteer →' },
  { label: 'Volunteer your time', href: withBase(VOLUNTEER_PATH), cta: 'Volunteer →' },
];
---

<section class="sec" id="support">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="kick">Support the mission</span>
        <h2>Ways to support</h2>
      </div>
    </div>
    <div class="support-grid">
      {
        options.map((opt) => (
          <a class="sup" href={opt.href} {...externalLinkAttrs(opt.href, Astro.url.origin)}>
            <span class="sup-l">{opt.label}</span>
            <span class="sup-go">{opt.cta}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .support-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
  }
  .sup {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    min-height: 120px;
    background: var(--paper-2);
    border-left: 3px solid var(--crimson);
    padding: 20px 18px;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .sup:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(30, 26, 27, 0.1);
  }
  .sup-l {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .sup-go {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--crimson);
  }
  @media (max-width: 900px) {
    .support-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
